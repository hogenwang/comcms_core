@model COMCMS.Core.Article
@{
    ViewBag.title = Model.Title;
    ViewBag.keywords = Model.Keyword;
    ViewBag.description = Model.Description;
    ArticleCategory kind = ViewBag.kind as ArticleCategory;
    IList<Article> alist = Article.FindAll(Article._.KId == Model.KId & Article._.IsHide == 0 & Article._.IsDel != 1, Article._.Sequence.Asc(), null, 0, 0);
    int topkid = (kind != null && kind.PId > 0) ? kind.PId : (kind?.Id ?? 1);
    string bannerBg = string.IsNullOrWhiteSpace(kind?.BannerImg) ? "/images/tech/inner-banner.svg" : kind.BannerImg;
}

<section class="tech-page-hero" style="background-image: url('@bannerBg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <span>@(kind?.KindName ?? "关于我们")</span>
            <span>/</span>
            <span>@Model.Title</span>
        </div>
        <h1>@Model.Title</h1>
        <p>以工程化思维打造安全、高效、可持续演进的企业级数字平台</p>
    </div>
</section>

@if (alist != null && alist.Count > 0)
{
    <div class="tech-subnav-bar">
        <div class="tech-container">
            <ul class="tech-subnav-list">
                @foreach (Article a in alist)
                {
                    <li class="@(a.Id == Model.Id ? "sec-on" : "")">
                        <a href="@ViewsHelper.EchoURL(a)" title="@a.Title">@a.Title</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        <article class="tech-prose-card">
            <header class="tech-detail-header">
                <h2>@Model.Title</h2>
                <div class="tech-detail-meta">
                    <span><i class="fa fa-building-o"></i> @(kind?.KindName ?? "关于我们")</span>
                    <span><i class="fa fa-calendar-o"></i> 更新于 @Model.AddTime.ToString("yyyy-MM-dd")</span>
                </div>
            </header>

            <div class="tech-prose">
                @Html.Raw(Model.Content)
            </div>
        </article>
    </div>
</section>

<script>
    $(function () {
        $("#nav_@(topkid)").addClass("nav-on");
    });
</script>
