@model COMCMS.Core.ArticleCategory
@{
    ViewBag.title = Model.KindName;
    ViewBag.keywords = Model.Keyword;
    ViewBag.description = Model.Description;
    IList<ArticleCategory> sameList = ArticleCategory.FindAll(ArticleCategory._.PId == Model.PId & ArticleCategory._.IsHide == 0, ArticleCategory._.Rank.Asc(), null, 0, 0);
    int topkid = Model.PId > 0 ? Model.PId : Model.Id;
    string bannerBg = string.IsNullOrWhiteSpace(Model.BannerImg) ? "/images/tech/inner-banner.svg" : Model.BannerImg;
    IList<Article> list = ViewBag.list as IList<Article>;
}

<section class="tech-page-hero" style="background-image: url('@bannerBg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <span>@Model.KindName</span>
        </div>
        <h1>@Model.KindName</h1>
        @if (!string.IsNullOrWhiteSpace(Model.KindInfo))
        {
            <p>@Utils.NoHTML(Model.KindInfo)</p>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>
</section>

@if (Model.PId > 0 && sameList != null && sameList.Count > 0)
{
    <div class="tech-subnav-bar">
        <div class="tech-container">
            <ul class="tech-subnav-list">
                @foreach (var k in sameList)
                {
                    <li class="@(k.Id == Model.Id ? "sec-on" : "")">
                        <a href="@ViewsHelper.EchoURL(k)" title="@k.KindName">@k.KindName</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        @if (list != null && list.Count > 0)
        {
            <div class="tech-article-list" id="listComment">
                @foreach (Article a in list)
                {
                    bool hasPic = !string.IsNullOrWhiteSpace(a.Pic);
                    <a href="@ViewsHelper.EchoArticleURL(a)" title="@a.Title" class="tech-article-item @(hasPic ? "" : "no-thumb")">
                        @if (hasPic)
                        {
                            <div class="tech-article-thumb">
                                <img src="@a.Pic" alt="@a.Title" onerror="this.onerror=null;this.src='/images/tech/placeholder-tech.svg';" />
                            </div>
                        }
                        <div class="tech-article-body">
                            <h3>@a.Title</h3>
                            <p>@Utils.CutString(Utils.NoHTML(a.Content ?? ""), 180)</p>
                            <div class="tech-article-meta">
                                <span><i class="fa fa-clock-o"></i> @a.AddTime.ToString("yyyy-MM-dd HH:mm")</span>
                                <span class="tech-card-link">查看详情 <i class="fa fa-long-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="tech-prose-card" style="text-align:center;color:var(--tech-text-muted);">
                <i class="fa fa-inbox" style="font-size:36px;color:#cbd5e1;margin-bottom:12px;"></i>
                <p style="margin:0;">暂无相关内容记录</p>
            </div>
        }

        <div class="tech-pagination">
            @Html.Raw(Pages.GetPageStr(ViewBag.pagesize, (int)ViewBag.totalCount, ViewBag.page, ViewsHelper.EchoURL(Model), 3, 10, ""))
        </div>
    </div>
</section>

<script>
    $(function () {
        $("#nav_@(topkid)").addClass("nav-on");
    });
</script>
