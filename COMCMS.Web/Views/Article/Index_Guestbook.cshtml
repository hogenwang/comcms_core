@model COMCMS.Core.ArticleCategory
@{
    ViewBag.title = Model.KindName;
    ViewBag.keywords = Model.Keyword;
    ViewBag.description = Model.Description;
    IList<ArticleCategory> sameList = ArticleCategory.FindAll(ArticleCategory._.PId == Model.PId & ArticleCategory._.IsHide == 0, ArticleCategory._.Rank.Asc(), null, 0, 0);
    int topkid = Model.PId > 0 ? Model.PId : Model.Id;
    string bannerBg = string.IsNullOrWhiteSpace(Model.BannerImg) ? "/images/tech/inner-banner.svg" : Model.BannerImg;
}

<section class="tech-page-hero" style="background-image: url('@bannerBg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <span>@Model.KindName</span>
        </div>
        <h1>@Model.KindName</h1>
        <p>请填写您的需求信息，我们将在第一时间安排专人与您对接</p>
    </div>
</section>

@if (Model.PId > 0 && sameList != null && sameList.Count > 0)
{
    <div class="tech-subnav-bar">
        <div class="tech-container">
            <ul class="tech-subnav-list">
                @foreach (var k in sameList)
                {
                    <li class="@(k.Id == Model.Id ? "sec-on" : "")">
                        <a href="@ViewsHelper.EchoURL(k)" title="@k.KindName">@k.KindName</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        <div class="tech-form-card">
            <div style="text-align:center;margin-bottom:28px;">
                <span class="tech-eyebrow"><i class="fa fa-envelope-open-o"></i> Online Message</span>
                <h2 style="margin:0 0 8px;font-size:26px;font-weight:800;">在线留言咨询</h2>
                <p style="margin:0;color:var(--tech-text-muted);font-size:14px;">提交您的联系方式与业务需求，获取定制化技术方案</p>
            </div>

            <form id="msgForm" onsubmit="return doPostMessage();" asp-antiforgery="true">
                <div class="tech-form-grid">
                    <div class="tech-field">
                        <label for="name_txt">您的姓名 *</label>
                        <input type="text" name="name_txt" id="name_txt" class="tech-input" placeholder="请输入您的姓名" required />
                    </div>
                    <div class="tech-field">
                        <label for="tel_txt">联系电话 *</label>
                        <input type="text" name="tel_txt" id="tel_txt" class="tech-input" placeholder="请输入手机或座机号码" required />
                    </div>
                </div>

                <div class="tech-field">
                    <label for="content_txt">留言内容 *</label>
                    <textarea name="content_txt" id="content_txt" rows="5" class="tech-textarea" placeholder="请详细描述您的项目需求、合作意向或问题反馈..." required></textarea>
                </div>

                <div class="tech-field">
                    <label for="tel_code">安全验证码</label>
                    <div class="tech-captcha-row">
                        <input type="text" name="tel_code" id="tel_code" class="tech-input" placeholder="请输入右侧验证码" style="max-width:220px;" />
                        <img src="/VerifyCode/MixVerifyCode" alt="验证码" title="点击刷新验证码" class="tech-captcha-img" onclick="getNewCode()" id="codeimg" />
                    </div>
                </div>

                <div style="margin-top:24px;text-align:center;">
                    <button type="submit" class="tech-btn tech-btn-primary" style="min-width:200px;">
                        <i class="fa fa-paper-plane-o"></i> 提交留言
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    function getNewCode() {
        $("#codeimg").attr("src", '/VerifyCode/MixVerifyCode?rnd=' + Math.random());
    }
    $(function () {
        $("#nav_@(topkid)").addClass("nav-on");
    });
</script>
