@model Tags
@{
    ViewBag.title = Model.TagName;
    ViewBag.keywords = Model.Keywords;
    ViewBag.description = Model.Description;
    IList<TagsDetail> list = ViewBag.list as IList<TagsDetail>;
}

<section class="tech-page-hero" style="background-image: url('/images/tech/inner-banner.svg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <a href="/Tag">TAG标签</a>
            <span>/</span>
            <span>@Model.TagName</span>
        </div>
        <h1>标签：@Model.TagName</h1>
        <p>共聚合 @(ViewBag.totalCount ?? 0) 篇相关内容</p>
    </div>
</section>

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        @if (list != null && list.Count > 0)
        {
            <div class="tech-article-list">
                @foreach (TagsDetail a in list)
                {
                    <a href="@ViewsHelper.EchoArticleURL(a.RId)" title="@a.Title" class="tech-article-item no-thumb">
                        <div class="tech-article-body">
                            <h3 style="margin-bottom:8px;">@a.Title</h3>
                            <div class="tech-article-meta">
                                <span><i class="fa fa-tag"></i> @Model.TagName</span>
                                <span class="tech-card-link">查看内容 <i class="fa fa-long-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="tech-prose-card" style="text-align:center;color:var(--tech-text-muted);">
                <p style="margin:0;">暂无相关内容记录</p>
            </div>
        }

        <div class="tech-pagination">
            @Html.Raw(Pages.GetPageStr(ViewBag.pagesize, (int)ViewBag.totalCount, ViewBag.page, "/tag/" + Model.TagName + "/{0}", 3, 10, ""))
        </div>
    </div>
</section>
