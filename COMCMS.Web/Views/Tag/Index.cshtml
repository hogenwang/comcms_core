@model IList<Tags>
@{
    ViewBag.title = "TAG标签";
    ViewBag.keywords = "TAG标签";
    ViewBag.description = "按内容主题标签快速浏览相关文章与技术资料";
}

<section class="tech-page-hero" style="background-image: url('/images/tech/inner-banner.svg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <span>TAG标签</span>
        </div>
        <h1>内容标签索引</h1>
        <p>按热门主题标签聚合检索站内文章与技术方案资料</p>
    </div>
</section>

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        <div class="tech-prose-card">
            @if (Model != null && Model.Count > 0)
            {
                <div class="tech-tag-cloud">
                    @foreach (Tags a in Model)
                    {
                        <a href="/tag/@a.TagName" title="@a.TagName" class="tech-tag-pill">
                            <i class="fa fa-tag" style="color:var(--tech-primary);"></i>
                            @a.TagName
                            <span>@a.Counts</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <p style="margin:0;text-align:center;color:var(--tech-text-muted);">暂无相关标签记录</p>
            }

            <div class="tech-pagination">
                @Html.Raw(Pages.GetPageStr(ViewBag.pagesize, (int)ViewBag.totalCount, ViewBag.page, "/Tag?page={0}", 3, 10, ""))
            </div>
        </div>
    </div>
</section>
