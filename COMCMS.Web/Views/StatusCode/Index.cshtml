@model int
@{
    ViewData["Title"] = $"{Model} - 页面提示";
    Layout = null;
    var statusCode = Model;
    var statusmessage = "请求处理异常";
    var tipmessage = "服务器暂时遇到了一点小状况，请稍后重试或返回首页。";
    switch (statusCode)
    {
        case 400:
            statusmessage = "无效的请求参数";
            tipmessage = "您的请求格式不正确，请检查链接地址后重试。";
            break;
        case 403:
            statusmessage = "暂无访问权限";
            tipmessage = "您当前没有权限访问该资源，请联系管理员或返回首页。";
            break;
        case 404:
            statusmessage = "页面未找到";
            tipmessage = "您访问的页面可能已被移动、删除或链接输入有误。";
            break;
        case 408:
            statusmessage = "请求超时";
            tipmessage = "服务器等待请求时间过长，请刷新页面重试。";
            break;
        case 500:
            statusmessage = "服务器内部错误";
            tipmessage = "系统服务处理请求时发生异常，请稍后再试。";
            break;
    }
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(Model) - @statusmessage</title>
    <link href="~/hplus/css/font-awesome.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
            background: radial-gradient(circle at 25% 25%, rgba(16, 185, 129, 0.16), transparent 45%),
                        radial-gradient(circle at 80% 75%, rgba(6, 182, 212, 0.18), transparent 48%),
                        #050b18;
            color: #f8fafc;
        }
        .err-card {
            width: 100%;
            max-width: 520px;
            padding: 46px 38px;
            border-radius: 20px;
            background: rgba(15, 23, 42, 0.78);
            border: 1px solid rgba(56, 189, 248, 0.22);
            backdrop-filter: blur(14px);
            box-shadow: 0 28px 70px rgba(0, 0, 0, 0.55);
            text-align: center;
        }
        .err-code {
            font-size: 76px;
            font-weight: 800;
            line-height: 1;
            margin: 0 0 12px;
            background: linear-gradient(135deg, #34d399 0%, #22d3ee 55%, #60a5fa 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .err-title {
            margin: 0 0 10px;
            font-size: 22px;
            font-weight: 700;
        }
        .err-desc {
            margin: 0 0 24px;
            font-size: 14.5px;
            color: #94a3b8;
            line-height: 1.7;
        }
        .err-url {
            margin: 0 0 28px;
            padding: 9px 14px;
            border-radius: 10px;
            background: rgba(5, 11, 24, 0.75);
            border: 1px solid rgba(148, 163, 184, 0.16);
            font-size: 12.5px;
            color: #cbd5e1;
            word-break: break-all;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }
        .err-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            border-radius: 10px;
            text-decoration: none;
            color: #fff;
            font-size: 14.5px;
            font-weight: 600;
            background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
            box-shadow: 0 10px 26px rgba(16, 185, 129, 0.32);
        }
        .err-btn:hover { opacity: 0.94; }
    </style>
</head>
<body>
    <div class="err-card">
        <div class="err-code">@Model</div>
        <h1 class="err-title">@statusmessage</h1>
        <p class="err-desc">@tipmessage</p>
        @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.url)))
        {
            <div class="err-url">@ViewBag.url</div>
        }
        <a href="/" class="err-btn"><i class="fa fa-home"></i> 返回首页</a>
    </div>
</body>
</html>
