@model COMCMS.Core.Category
@{
    ViewBag.title = Model.KindName;
    ViewBag.keywords = Model.Keyword;
    ViewBag.description = Model.Description;
    IList<Category> sameList = Category.FindAll(Category._.PId == 0 & Category._.IsHide == 0, Category._.Rank.Asc(), null, 0, 0);
    string bannerBg = string.IsNullOrWhiteSpace(Model.BannerImg) ? "/images/tech/inner-banner.svg" : Model.BannerImg;
    IList<Product> list = ViewBag.list as IList<Product>;
}

<section class="tech-page-hero" style="background-image: url('@bannerBg');">
    <div class="tech-container tech-page-hero-inner">
        <div class="tech-breadcrumb">
            <a href="/"><i class="fa fa-home"></i> 首页</a>
            <span>/</span>
            <span>产品中心</span>
            <span>/</span>
            <span>@Model.KindName</span>
        </div>
        <h1>@Model.KindName</h1>
        @if (!string.IsNullOrWhiteSpace(Model.KindInfo))
        {
            <p>@Utils.NoHTML(Model.KindInfo)</p>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
        else
        {
            <p>探索面向企业级场景构建的模块化软件产品与行业数字化解决方案</p>
        }
    </div>
</section>

@if (sameList != null && sameList.Count > 0)
{
    <div class="tech-subnav-bar">
        <div class="tech-container">
            <ul class="tech-subnav-list">
                @foreach (var k in sameList)
                {
                    <li class="@(k.Id == Model.Id ? "sec-on" : "")">
                        <a href="@ViewsHelper.EchoURL(k)" title="@k.KindName">@k.KindName</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<section class="tech-section tech-section-alt">
    <div class="tech-container">
        @if (list != null && list.Count > 0)
        {
            <div class="tech-product-grid" id="listComment">
                @foreach (Product p in list)
                {
                    string prodImg = string.IsNullOrWhiteSpace(p.Pic) ? "/images/tech/placeholder-tech.svg" : p.Pic;
                    string prodSummary = !string.IsNullOrWhiteSpace(p.Description)
                        ? p.Description
                        : Utils.CutString(Utils.NoHTML(p.Content ?? ""), 88);
                    if (string.IsNullOrWhiteSpace(prodSummary))
                    {
                        prodSummary = "企业级软件解决方案，支持快速部署与深度二次开发扩展。";
                    }
                    <article class="tech-product-card">
                        <a href="@ViewsHelper.EchoURL(p)" title="@p.Title" class="tech-product-thumb">
                            <img src="@prodImg" alt="@p.Title" onerror="this.onerror=null;this.src='/images/tech/placeholder-tech.svg';" />
                        </a>
                        <div class="tech-product-body">
                            <h3 class="tech-product-title">
                                <a href="@ViewsHelper.EchoURL(p)" title="@p.Title">@p.Title</a>
                            </h3>
                            <p class="tech-product-desc">@prodSummary</p>
                            <a href="@ViewsHelper.EchoURL(p)" class="tech-card-link">
                                查看方案详情 <i class="fa fa-long-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="tech-prose-card" style="text-align:center;color:var(--tech-text-muted);">
                <i class="fa fa-cubes" style="font-size:36px;color:#cbd5e1;margin-bottom:12px;"></i>
                <p style="margin:0;">当前分类暂无产品记录</p>
            </div>
        }

        <div class="tech-pagination">
            @Html.Raw(Pages.GetPageStr(ViewBag.pagesize, (int)ViewBag.totalCount, ViewBag.page, $"/Product/Index/{Model.Id}" + "?page={0}", 99, 10, ""))
        </div>
    </div>
</section>

<script>
    $(function () {
        $("#nav_P").addClass("nav-on");
    });
</script>
