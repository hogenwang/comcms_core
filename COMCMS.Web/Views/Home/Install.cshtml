@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COMCMS 初始化</title>
    <link href="~/lib/bootstrap5/bootstrap.min.css" rel="stylesheet" />
    <link href="~/hplus/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/hplus/css/animate.min.css" rel="stylesheet" />
    <link href="~/css/admin-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-bs3-compat.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-modern.css" rel="stylesheet" asp-append-version="true" />
    <script>if (window.top !== window.self) { window.top.location = window.location; }</script>
    <style>
        body.install-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            background: #f3f3f4;
        }
        .install-card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border: 1px solid #e7eaec;
            border-radius: 8px;
            box-shadow: 0 8px 28px rgba(15, 23, 42, 0.08);
            padding: 36px 32px 28px;
        }
        .install-brand {
            font-size: 36px;
            font-weight: 800;
            letter-spacing: 2px;
            color: #1ab394;
            margin-bottom: 6px;
        }
    </style>
</head>
<body class="gray-bg install-page">
    <div class="install-card animated fadeInDown">
        <div class="text-center">
            <div class="install-brand">COMCMS</div>
            <h3 style="margin-top:0;margin-bottom:24px;color:#475569;font-weight:400;">初始化系统数据</h3>
        </div>
        <form asp-controller="Home" asp-action="DoInstall" id="installForm" role="form" method="post" asp-antiforgery="true">
            <div class="form-group">
                <input type="text" name="sitename" id="sitename" class="form-control" placeholder="网站名称" required value="comcms">
            </div>
            <div class="form-group">
                <input type="text" name="siteurl" id="siteurl" class="form-control" placeholder="网站URL地址" required value="@Utils.GetServerUrl()">
            </div>
            @if (ViewBag.sqltype == "mysql")
            {
                <div class="form-group">
                    <select class="form-control" name="mysqltype" id="mysqltype">
                        <option value="windows">Windows 下 Mysql(数据库表不区分大小写)</option>
                        <option value="linux">Linux 下 Mysql(数据库表区分大小写)</option>
                    </select>
                </div>
            }
            <div class="form-group">
                <input type="text" name="username" id="username" class="form-control" placeholder="超级管理员登录账号（至少5位）" required>
            </div>
            <div class="form-group">
                <input type="password" name="password" id="password" class="form-control" placeholder="超级管理员登录密码（12-128位）" required>
            </div>
            <div class="form-group">
                <input type="password" name="password2" id="password2" class="form-control" placeholder="确认登录密码" required>
            </div>
            <button type="submit" class="btn btn-primary block full-width m-b">确认安装</button>
            <p class="text-muted text-center" style="margin-bottom:0;">
                COMCMS © 2014-@DateTime.Now.Year
            </p>
        </form>
    </div>
    <environment names="Development">
        <script src="~/js/jquery-3.min.js"></script>
        <script src="~/lib/bootstrap5/bootstrap.bundle.min.js"></script>
        <script src="~/js/validation/jquery.validate.js"></script>
        <script src="~/js/validation/messages_zh.js"></script>
        <script src="~/js/layer/layer.js"></script>
        <script src="~/js/jquery.form.js"></script>
        <script src="~/js/rtpost.js"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/js/jquery-3.min.js"></script>
        <script src="~/lib/bootstrap5/bootstrap.bundle.min.js"></script>
        <script src="~/js/validation/jquery.validate.min.js"></script>
        <script src="~/js/validation/messages_zh.min.js"></script>
        <script src="~/js/layer/layer.js"></script>
        <script src="~/js/jquery.form.min.js"></script>
        <script src="~/js/rtpost.js"></script>
    </environment>
    <script>
        $(function () {
            var rules = {
                username: {
                    required: true,
                    minlength: 5
                },
                password: {
                    required: true,
                    minlength: 12,
                    maxlength: 128
                }
            };
            DoPost("installForm", rules, "提交初始化安装");
        });
    </script>
</body>
</html>
