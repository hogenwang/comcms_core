@using COMCMS.Core.Models
@{
    Config cfg = ViewBag.cfg as Config ?? Config.GetSystemConfig();
    ViewBag.title = string.IsNullOrEmpty(cfg?.IndexTitle) ? cfg?.SiteName : cfg.IndexTitle;
    ViewBag.keywords = cfg?.Keyword;
    ViewBag.description = cfg?.Description;

    Article about = ViewBag.about;
    IList<Link> listLinks = Link.FindAll(Link._.KId == 1 & Link._.IsHide == false, Link._.Sequence.Asc(), null, 0, 0);
    if (listLinks == null || listLinks.Count == 0)
    {
        listLinks = Link.FindAll(Link._.KId == 1, Link._.Sequence.Asc(), null, 0, 0);
    }

    var bannerPC = Ads.GetSlideAds(1);
    IList<Product> listProducts = Product.FindAll(Product._.IsHide == 0, Product._.Sequence.Asc(), null, 0, 6);
    IList<Article> listNews1 = Article.FindAll(Article._.KId == 6 & Article._.IsHide != 1 & Article._.IsDel != 1, Article._.Sequence.Asc() & Article._.Id.Desc(), null, 0, 4);
    IList<Article> listNews2 = Article.FindAll(Article._.KId == 7 & Article._.IsHide != 1 & Article._.IsDel != 1, Article._.Sequence.Asc() & Article._.Id.Desc(), null, 0, 4);

    string aboutSummary = Utils.CutString(Utils.NoHTML(about?.Content ?? ""), 320);
    if (string.IsNullOrWhiteSpace(aboutSummary))
    {
        aboutSummary = "专注于企业级数字化内容管理与多端业务协同平台研发，提供安全稳定、开源可控、高可扩展的一体化技术解决方案，助力企业快速完成数字化转型升级。";
    }
    string aboutImg = string.IsNullOrWhiteSpace(about?.Pic) ? "/images/tech/about-platform.svg" : about.Pic;
}

<!-- Obsidian Tech Hero -->
<section class="tech-hero">
    <div class="tech-container tech-hero-grid">
        <div>
            <div class="tech-hero-badge">
                <span class="tech-pulse-dot"></span>
                <span>ENTERPRISE DIGITAL PLATFORM</span>
            </div>
            <h1 class="tech-hero-title">
                构建面向未来的<br />
                <span class="accent">企业级数字内容中枢</span>
            </h1>
            <p class="tech-hero-lead">
                @(string.IsNullOrWhiteSpace(cfg?.Description) ? "基于现代跨平台架构打造，融合内容管理、产品矩阵展示、多终端适配与企业级安全防护，让品牌官网与数字业务高效协同演进。" : cfg.Description)
            </p>
            <div class="tech-hero-cta">
                <a href="@ViewsHelper.EchoURL(Utils.CMSType.ProductCategory, 1)" class="tech-btn tech-btn-primary">
                    <i class="fa fa-th-large"></i> 探索产品矩阵
                </a>
                <a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 1)" class="tech-btn tech-btn-ghost">
                    <i class="fa fa-compass"></i> 了解企业实力
                </a>
            </div>
            <div class="tech-hero-stats">
                <div class="tech-stat-item">
                    <strong>100%</strong>
                    <span>开源自主可控架构</span>
                </div>
                <div class="tech-stat-item">
                    <strong>跨平台</strong>
                    <span>高性能云原生部署</span>
                </div>
                <div class="tech-stat-item">
                    <strong>全终端</strong>
                    <span>PC · 移动 · 小程序协同</span>
                </div>
            </div>
        </div>

        <div class="tech-hero-visual">
            <div class="tech-showcase-frame">
                <div class="tech-showcase-bar">
                    <span class="tech-window-dots"><i></i><i></i><i></i></span>
                    <span class="tech-window-label">comcms.platform // live-showcase</span>
                </div>
                <div class="tech-hero-slider">
                    @if (bannerPC != null && bannerPC.Any())
                    {
                        <div class="swiper-container">
                            <div class="swiper-wrapper">
                                @foreach (var img in bannerPC)
                                {
                                    string slideHref = string.IsNullOrWhiteSpace(img.link) ? "javascript:;" : img.link;
                                    <div class="swiper-slide">
                                        <a href="@slideHref" title="@img.alt">
                                            <img src="@img.img" alt="@img.alt" onerror="this.onerror=null;this.src='/images/tech/hero-tech.svg';" />
                                            @if (!string.IsNullOrWhiteSpace(img.alt))
                                            {
                                                <div class="tech-hero-slider-caption">@img.alt</div>
                                            }
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (bannerPC.Count > 1)
                        {
                            <button type="button" class="tech-slider-nav tech-slider-prev" aria-label="上一张"><i class="fa fa-angle-left"></i></button>
                            <button type="button" class="tech-slider-nav tech-slider-next" aria-label="下一张"><i class="fa fa-angle-right"></i></button>
                        }
                    }
                    else
                    {
                        <img src="/images/tech/hero-tech.svg" alt="@cfg?.SiteName" style="width:100%;height:100%;object-fit:cover;" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Floating Core Advantages -->
<section class="tech-advantages">
    <div class="tech-container">
        <div class="tech-adv-grid">
            <div class="tech-adv-card">
                <div class="tech-adv-icon"><i class="fa fa-rocket"></i></div>
                <div>
                    <h3>跨平台高性能内核</h3>
                    <p>基于现代 .NET Core 跨平台技术架构，支持 Windows / Linux / 容器化高并发稳定运行。</p>
                </div>
            </div>
            <div class="tech-adv-card">
                <div class="tech-adv-icon"><i class="fa fa-shield"></i></div>
                <div>
                    <h3>完全开源 · 安全可控</h3>
                    <p>代码清晰开放，内置细粒度 RBAC 权限管控、防 CSRF 及全链路安全策略，二次开发无门槛。</p>
                </div>
            </div>
            <div class="tech-adv-card">
                <div class="tech-adv-icon"><i class="fa fa-cubes"></i></div>
                <div>
                    <h3>多场景业务广泛赋能</h3>
                    <p>全面覆盖企业门户、产品展示、微商城、小程序及内容资讯站，灵活适配各类业务形态。</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Enterprise Section -->
<section class="tech-section">
    <div class="tech-container tech-about-grid">
        <div class="tech-about-media">
            <div class="tech-about-img-wrap">
                <a href="@(ViewsHelper.EchoArticleURL(1))" title="关于我们">
                    <img src="@aboutImg" alt="关于我们" onerror="this.onerror=null;this.src='/images/tech/about-platform.svg';" />
                </a>
            </div>
            <div class="tech-about-float">
                <strong>Enterprise Ready</strong>
                <span>稳定 · 安全 · 高扩展数字化底座</span>
            </div>
        </div>

        <div class="tech-about-body">
            <span class="tech-eyebrow"><i class="fa fa-cube"></i> About Us</span>
            <h2 class="tech-section-title">以技术创新驱动企业数字化增长</h2>
            <p>@aboutSummary</p>
            <div class="tech-about-chips">
                <span class="tech-chip"><i class="fa fa-check-circle"></i> 模块化插件体系</span>
                <span class="tech-chip"><i class="fa fa-check-circle"></i> 响应式全端适配</span>
                <span class="tech-chip"><i class="fa fa-check-circle"></i> 企业级安全加固</span>
                <span class="tech-chip"><i class="fa fa-check-circle"></i> 可视化内容编排</span>
            </div>
            <a href="@(ViewsHelper.EchoArticleURL(1))" class="tech-btn tech-btn-primary">
                了解更多企业详情 <i class="fa fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- Product Matrix Showcase -->
<section class="tech-section tech-section-alt">
    <div class="tech-container">
        <div class="tech-section-head">
            <span class="tech-eyebrow"><i class="fa fa-th-large"></i> Product Matrix</span>
            <h2 class="tech-section-title">核心产品与解决方案</h2>
            <p class="tech-section-desc">面向不同规模企业的数字化场景需求，提供开箱即用、可持续演进的产品体系</p>
        </div>

        <div class="tech-product-grid">
            @foreach (var p in listProducts)
            {
                string prodImg = string.IsNullOrWhiteSpace(p.Pic) ? "/images/tech/placeholder-tech.svg" : p.Pic;
                string prodSummary = !string.IsNullOrWhiteSpace(p.Description)
                    ? p.Description
                    : Utils.CutString(Utils.NoHTML(p.Content ?? ""), 84);
                if (string.IsNullOrWhiteSpace(prodSummary))
                {
                    prodSummary = "企业级模块化解决方案，支持灵活定制与多终端业务无缝协同。";
                }
                <article class="tech-product-card">
                    <a href="@ViewsHelper.EchoURL(p)" title="@p.Title" class="tech-product-thumb">
                        <img src="@prodImg" alt="@p.Title" onerror="this.onerror=null;this.src='/images/tech/placeholder-tech.svg';" />
                    </a>
                    <div class="tech-product-body">
                        <h3 class="tech-product-title">
                            <a href="@ViewsHelper.EchoURL(p)" title="@p.Title">@p.Title</a>
                        </h3>
                        <p class="tech-product-desc">@prodSummary</p>
                        <a href="@ViewsHelper.EchoURL(p)" class="tech-card-link">
                            查看方案详情 <i class="fa fa-long-arrow-right"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

        <div class="tech-section-footer">
            <a href="@ViewsHelper.EchoCategoryURL(1)" class="tech-btn tech-btn-outline">
                查看全部产品 <i class="fa fa-angle-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- News & Insights Tabs -->
<section class="tech-section">
    <div class="tech-container">
        <div class="tech-section-head">
            <span class="tech-eyebrow"><i class="fa fa-newspaper-o"></i> News &amp; Insights</span>
            <h2 class="tech-section-title">新闻动态与行业洞察</h2>
            <p class="tech-section-desc">持续追踪技术演进、产品迭代与企业数字化实践案例</p>
        </div>

        <div class="tech-tabs" role="tablist">
            <button type="button" class="tech-tab-btn is-active" data-tab="newsPanelCompany">公司新闻</button>
            <button type="button" class="tech-tab-btn" data-tab="newsPanelIndustry">行业资讯</button>
        </div>

        <!-- Panel 1: Company News -->
        <div class="tech-news-panel is-active" id="newsPanelCompany">
            @if (listNews1 != null && listNews1.Count > 0)
            {
                var lead1 = listNews1[0];
                string lead1Img = string.IsNullOrWhiteSpace(lead1.Pic) ? "/images/tech/placeholder-tech.svg" : lead1.Pic;
                <a href="@ViewsHelper.EchoURL(lead1)" title="@lead1.Title" class="tech-news-featured">
                    <div class="tech-news-featured-img">
                        <img src="@lead1Img" alt="@lead1.Title" onerror="this.onerror=null;this.src='/images/tech/placeholder-tech.svg';" />
                    </div>
                    <div class="tech-news-featured-body">
                        <span class="tech-news-date"><i class="fa fa-calendar-o"></i> @lead1.AddTime.ToString("yyyy-MM-dd")</span>
                        <h3>@lead1.Title</h3>
                        <p>@Utils.CutString(Utils.NoHTML(lead1.Content ?? ""), 150)</p>
                        <span class="tech-card-link">阅读全文 <i class="fa fa-long-arrow-right"></i></span>
                    </div>
                </a>

                <div class="tech-news-stack">
                    @for (int i = 1; i < listNews1.Count; i++)
                    {
                        var item = listNews1[i];
                        <a href="@ViewsHelper.EchoURL(item)" title="@item.Title" class="tech-news-row">
                            <div class="tech-date-badge">
                                <strong>@item.AddTime.ToString("dd")</strong>
                                <span>@item.AddTime.ToString("yyyy-MM")</span>
                            </div>
                            <div class="tech-news-row-body">
                                <h4>@item.Title</h4>
                                <p>@Utils.CutString(Utils.NoHTML(item.Content ?? ""), 96)</p>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="tech-section-desc">暂无公司新闻记录。</p>
            }
        </div>

        <!-- Panel 2: Industry News -->
        <div class="tech-news-panel" id="newsPanelIndustry">
            @if (listNews2 != null && listNews2.Count > 0)
            {
                var lead2 = listNews2[0];
                string lead2Img = string.IsNullOrWhiteSpace(lead2.Pic) ? "/images/tech/placeholder-tech.svg" : lead2.Pic;
                <a href="@ViewsHelper.EchoURL(lead2)" title="@lead2.Title" class="tech-news-featured">
                    <div class="tech-news-featured-img">
                        <img src="@lead2Img" alt="@lead2.Title" onerror="this.onerror=null;this.src='/images/tech/placeholder-tech.svg';" />
                    </div>
                    <div class="tech-news-featured-body">
                        <span class="tech-news-date"><i class="fa fa-calendar-o"></i> @lead2.AddTime.ToString("yyyy-MM-dd")</span>
                        <h3>@lead2.Title</h3>
                        <p>@Utils.CutString(Utils.NoHTML(lead2.Content ?? ""), 150)</p>
                        <span class="tech-card-link">阅读全文 <i class="fa fa-long-arrow-right"></i></span>
                    </div>
                </a>

                <div class="tech-news-stack">
                    @for (int i = 1; i < listNews2.Count; i++)
                    {
                        var item = listNews2[i];
                        <a href="@ViewsHelper.EchoURL(item)" title="@item.Title" class="tech-news-row">
                            <div class="tech-date-badge">
                                <strong>@item.AddTime.ToString("dd")</strong>
                                <span>@item.AddTime.ToString("yyyy-MM")</span>
                            </div>
                            <div class="tech-news-row-body">
                                <h4>@item.Title</h4>
                                <p>@Utils.CutString(Utils.NoHTML(item.Content ?? ""), 96)</p>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="tech-section-desc">暂无行业资讯记录。</p>
            }
        </div>

        <div class="tech-section-footer">
            <a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 2)" class="tech-btn tech-btn-outline">
                进入新闻中心 <i class="fa fa-angle-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- Partners Strip -->
@if (listLinks != null && listLinks.Count > 0)
{
    <section class="tech-section tech-section-alt">
        <div class="tech-container">
            <div class="tech-section-head">
                <span class="tech-eyebrow"><i class="fa fa-handshake-o"></i> Ecosystem Partners</span>
                <h2 class="tech-section-title">生态合作伙伴</h2>
                <p class="tech-section-desc">携手行业优秀技术与服务伙伴，共同构建开放共赢的数字化生态</p>
            </div>

            <div class="tech-partners-grid">
                @foreach (var l in listLinks)
                {
                    string partnerUrl = string.IsNullOrWhiteSpace(l.LinkURL) ? "javascript:;" : l.LinkURL;
                    bool isExternal = partnerUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || partnerUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                    <a href="@partnerUrl" title="@l.Title" class="tech-partner-card" @(isExternal ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")>
                        @if (!string.IsNullOrWhiteSpace(l.Logo))
                        {
                            <img src="@l.Logo" alt="@l.Title" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
                            <span class="tech-partner-fallback" style="display:none;"><i class="fa fa-building-o"></i> @l.Title</span>
                        }
                        else
                        {
                            <span class="tech-partner-fallback"><i class="fa fa-building-o"></i> @l.Title</span>
                        }
                    </a>
                }
            </div>
        </div>
    </section>
}

<script>
    $(function () {
        $("#nav_0").addClass("nav-on");
    });
</script>
