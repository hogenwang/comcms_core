@{
    Config cfg = ViewBag.cfg as Config ?? Config.GetSystemConfig();
    string siteName = string.IsNullOrWhiteSpace(cfg?.SiteName) ? "COMCMS" : cfg.SiteName;
    string siteTel = string.IsNullOrWhiteSpace(cfg?.SiteTel) ? "+86-20-88888888" : cfg.SiteTel;
    string siteEmail = string.IsNullOrWhiteSpace(cfg?.SiteEmail) ? "hogenwang@vip.qq.com" : cfg.SiteEmail;

    IList<ArticleCategory> allArticleCategorys = ArticleCategory.GetListTree(0, -1, false, false);
    IList<Article> aboutlist = Article.FindAll(Article._.KId == 1 & Article._.IsHide == 0 & Article._.IsDel != 1, Article._.Sequence.Asc(), null, 0, 0);
    IList<Category> allCategorys = Category.FindAll(Category._.PId == 0 & Category._.IsHide == 0, Category._.Rank.Asc(), null, 0, 0);
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.title</title>
    <meta name="renderer" content="webkit" />
    <meta name="keywords" content="@ViewBag.keywords">
    <meta name="description" content="@ViewBag.description">
    <link href="~/hplus/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/js/swpier/swiper.min.css" rel="stylesheet" />
    <link href="~/css/site-tech.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/jquery-3.min.js"></script>
    <script src="~/js/swpier/swiper.min.js"></script>
    <script src="~/js/site-tech.js" asp-append-version="true"></script>
</head>
<body class="tech-site">
    <!-- Sticky Tech Glass Header -->
    <header class="tech-header" id="siteHeader">
        <div class="tech-container tech-header-inner">
            <a href="/" title="@siteName" class="tech-brand">
                @if (!string.IsNullOrWhiteSpace(cfg?.SiteLogo))
                {
                    <img src="@cfg.SiteLogo" alt="@siteName" class="tech-brand-logo" onerror="this.style.display='none'" />
                }
                <span class="tech-brand-name">@siteName</span>
            </a>

            <nav class="tech-nav-wrap" id="siteNavWrap" aria-label="主导航">
                <ul class="tech-nav">
                    <li id="nav_0"><a href="/" title="首页">首页</a></li>
                    <li id="nav_1"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 1)" title="关于我们">关于我们</a></li>
                    <li id="nav_P"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ProductCategory, 1)" title="产品中心">产品中心</a></li>
                    <li id="nav_2"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 2)" title="新闻资讯">新闻资讯</a></li>
                    <li id="nav_3"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 3)" title="项目案例">项目案例</a></li>
                    <li id="nav_4"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 4)" title="用户服务">用户服务</a></li>
                    <li id="nav_5"><a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 5)" title="联系我们">联系我们</a></li>
                </ul>
            </nav>

            <div class="tech-header-actions">
                <a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 5)" class="tech-btn-nav">
                    <i class="fa fa-paper-plane-o"></i> 在线咨询
                </a>
                <button type="button" class="tech-mobile-toggle" id="mobileNavToggle" aria-label="展开导航菜单" aria-expanded="false">
                    <i class="fa fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- Dark Enterprise Tech Footer -->
    <footer class="tech-footer">
        <div class="tech-container tech-footer-main">
            <div>
                <div class="tech-footer-brand">@siteName</div>
                <div class="tech-footer-sub">ENTERPRISE DIGITAL CONTENT PLATFORM</div>
                <ul class="tech-footer-contact">
                    <li><i class="fa fa-phone"></i><span>服务热线：@siteTel</span></li>
                    <li><i class="fa fa-envelope-o"></i><span>联系邮箱：<a href="mailto:@siteEmail">@siteEmail</a></span></li>
                    <li><i class="fa fa-map-marker"></i><span>公司地址：广东省广州市天河区天河城</span></li>
                </ul>
            </div>

            <div class="tech-footer-links">
                <div class="tech-footer-col">
                    <h4>关于我们</h4>
                    <ul>
                        @foreach (Article a in aboutlist)
                        {
                            <li><a asp-controller="Article" asp-action="Detail" asp-route-id="@(a.Id)" title="@a.Title">@a.Title</a></li>
                        }
                    </ul>
                </div>

                <div class="tech-footer-col">
                    <h4>产品与方案</h4>
                    <ul>
                        @foreach (Category c in allCategorys)
                        {
                            <li><a asp-controller="Product" asp-action="Index" asp-route-id="@(c.Id)" title="@(c.KindName)">@(c.KindName)</a></li>
                        }
                        @foreach (ArticleCategory ac in allArticleCategorys)
                        {
                            if (ac.PId == 4)
                            {
                                <li><a asp-controller="Article" asp-action="Index" asp-route-id="@(ac.Id)" title="@ac.KindName">@ac.KindName</a></li>
                            }
                        }
                    </ul>
                </div>

                <div class="tech-footer-col">
                    <h4>资讯与支持</h4>
                    <ul>
                        @foreach (ArticleCategory ac in allArticleCategorys)
                        {
                            if (ac.PId == 2 || ac.PId == 5)
                            {
                                <li><a asp-controller="Article" asp-action="Index" asp-route-id="@(ac.Id)" title="@ac.KindName">@ac.KindName</a></li>
                            }
                        }
                    </ul>
                </div>
            </div>

            <div class="tech-footer-form">
                <h4><i class="fa fa-comments-o"></i> 快速留言咨询</h4>
                <form id="footerMessageForm" name="footerMessageForm" onsubmit="return doPostFooterMessage();" asp-antiforgery="true">
                    <input type="text" name="name" id="name" class="tech-footer-input" placeholder="您的姓名" required />
                    <input type="text" name="phone" id="phone" class="tech-footer-input" placeholder="联系电话" required />
                    <textarea name="content" id="content" rows="3" class="tech-footer-textarea" placeholder="请简述您的项目需求或咨询内容..." required></textarea>
                    <button type="submit" class="tech-btn tech-btn-primary" style="width:100%;padding:10px 18px;font-size:14px;">
                        <i class="fa fa-send-o"></i> 提交留言
                    </button>
                </form>
            </div>
        </div>

        <div class="tech-footer-bottom">
            <div class="tech-container tech-footer-bottom-inner">
                <div>
                    @cfg?.Copyright
                    @if (!string.IsNullOrWhiteSpace(cfg?.ICP))
                    {
                        <span> · @cfg.ICP</span>
                    }
                    <span> · <a href="https://www.comcms.com/" target="_blank" rel="noopener noreferrer">Powered by COMCMS</a></span>
                </div>
                <div class="tech-footer-bottom-links">
                    <a href="/sitemap.html">网站地图</a>
                    <a href="/Tag">标签索引</a>
                    <a href="@ViewsHelper.EchoURL(Utils.CMSType.ArticleCategory, 5)">联系我们</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
