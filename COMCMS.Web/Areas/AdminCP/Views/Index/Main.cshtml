@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment env
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@using NewLife
@using System.Runtime
@using System.Diagnostics
@{
    Layout = null;
    Admin my = ViewBag.admin;
    var mi = MachineInfo.Current ?? new MachineInfo();
    long articleCount = Article.FindCount(null, null, null, 0, 0);
    long productCount = Product.FindCount(null, null, null, 0, 0);
    long memberCount = Member.FindCount(null, null, null, 0, 0);
    long unreadGuestbook = Guestbook.FindCount(Guestbook._.IsRead == 0, null, null, 0, 0);
}
@functions {
    public string GetAntiXsrfRequestToken()
    {
        return Xsrf.GetAndStoreTokens(Context).RequestToken;
    }
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>控制台首页 - COMCMS</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('comcms_admin_theme') === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>
    <link href="~/lib/bootstrap5/bootstrap.min.css" rel="stylesheet" />
    <link href="~/hplus/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/hplus/css/animate.min.css" rel="stylesheet" />
    <link href="~/css/admin-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-bs3-compat.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-modern.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/jquery-3.min.js"></script>
    <script src="~/lib/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="~/js/layer/layer.js"></script>
    <script src="~/js/vue/vue.min.js"></script>
    <script src="~/js/admin-modern.js" asp-append-version="true"></script>
    <script>
        var csrfToken = '@GetAntiXsrfRequestToken()';
    </script>
</head>
<body class="gray-bg">
    <div class="wrapper wrapper-content">
        <!-- 欢迎横幅与快捷操作 -->
        <div class="adm-dash-hero">
            <div>
                <h2>欢迎回来，@(my?.UserName ?? "管理员")</h2>
                <p>当前角色：@(my?.Roles?.RoleName ?? "管理员") · 今天是 @DateTime.Now.ToString("yyyy年MM月dd日")，系统运行平稳</p>
            </div>
            <div class="adm-quick-actions">
                <button type="button" class="adm-quick-btn is-primary" onclick="openQuickDialog('addarticle', '添加文章', '/AdminCP/Article/AddArticle')">
                    <i class="fa fa-plus-circle"></i> 发布文章
                </button>
                <button type="button" class="adm-quick-btn" onclick="openQuickDialog('addproduct', '添加商品', '/AdminCP/Product/AddProduct')">
                    <i class="fa fa-cube"></i> 发布商品
                </button>
                <button type="button" class="adm-quick-btn" onclick="openMenuTab('/AdminCP/Attach/Index')">
                    <i class="fa fa-folder-open-o"></i> 附件管理
                </button>
                <button type="button" class="adm-quick-btn" onclick="openMenuTab('/AdminCP/System/BaseConfig')">
                    <i class="fa fa-cog"></i> 基本配置
                </button>
            </div>
        </div>

        <!-- 四大核心数据指标卡 -->
        <div class="adm-kpi-grid">
            <div class="adm-kpi-card" style="cursor:pointer;" onclick="openMenuTab('/AdminCP/Article/ArticleList')">
                <div>
                    <div class="adm-kpi-label">网站文章总数</div>
                    <div class="adm-kpi-value">@articleCount</div>
                    <div class="adm-kpi-sub"><span id="resultspan">内容库实时统计</span></div>
                </div>
                <div class="adm-kpi-icon is-emerald"><i class="fa fa-file-text-o"></i></div>
            </div>

            <div class="adm-kpi-card" style="cursor:pointer;" onclick="openMenuTab('/AdminCP/Product/ProductList')">
                <div>
                    <div class="adm-kpi-label">产品与方案总数</div>
                    <div class="adm-kpi-value">@productCount</div>
                    <div class="adm-kpi-sub">已收录全部产品记录</div>
                </div>
                <div class="adm-kpi-icon is-sky"><i class="fa fa-cubes"></i></div>
            </div>

            <div class="adm-kpi-card" style="cursor:pointer;" onclick="openMenuTab('/AdminCP/Member/Members')">
                <div>
                    <div class="adm-kpi-label">注册会员总数</div>
                    <div class="adm-kpi-value">@memberCount</div>
                    <div class="adm-kpi-sub">系统累计会员账户</div>
                </div>
                <div class="adm-kpi-icon is-amber"><i class="fa fa-users"></i></div>
            </div>

            <div class="adm-kpi-card" style="cursor:pointer;" onclick="openMenuTab('/AdminCP/Guestbook/GuestbookList')">
                <div>
                    <div class="adm-kpi-label">待处理未读留言</div>
                    <div class="adm-kpi-value" id="smsCount">@unreadGuestbook</div>
                    <div class="adm-kpi-sub">点击前往留言管理</div>
                </div>
                <div class="adm-kpi-icon is-rose"><i class="fa fa-envelope-o"></i></div>
            </div>
        </div>

        @if (my != null && my.Roles != null && my.Roles.IsSuperAdmin == 1)
        {
            <div class="adm-monitor-grid" id="app">
                <!-- 服务器运行监控 -->
                <div class="adm-info-card">
                    <div class="adm-info-card-head">
                        <span><i class="fa fa-server"></i>服务器实时监控</span>
                        <span class="label label-success">运行中</span>
                    </div>
                    <div class="adm-info-card-body">
                        <ul class="adm-kv-list">
                            <li>
                                <span class="adm-kv-key">主机名称</span>
                                <span class="adm-kv-val">@Environment.MachineName</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">操作系统</span>
                                <span class="adm-kv-val">@mi.OSName @mi.OSVersion @System.Runtime.InteropServices.RuntimeInformation.OSArchitecture</span>
                            </li>
                            <li style="flex-direction:column;align-items:stretch;">
                                <div style="display:flex;justify-content:space-between;gap:10px;">
                                    <span class="adm-kv-key">处理器 (@Environment.ProcessorCount 核)</span>
                                    <span class="adm-kv-val">占用 {{info.cpuRate}}%</span>
                                </div>
                                <div class="adm-meter-track">
                                    <div class="adm-meter-fill" v-bind:class="info.cpuRate > 80 ? 'is-warn' : ''" v-bind:style="{ width: Math.min(100, Math.max(2, Number(info.cpuRate) || 0)) + '%' }"></div>
                                </div>
                            </li>
                            <li style="flex-direction:column;align-items:stretch;">
                                <div style="display:flex;justify-content:space-between;gap:10px;">
                                    <span class="adm-kv-key">服务器内存</span>
                                    <span class="adm-kv-val">{{info.availableMemory}} 可用 / @((mi.Memory / 1024 / 1024).ToString("n0"))M (<span v-bind:class="info.memoryUsage < 10 ? 'text-danger' : ''">{{info.memoryUsage}}% 空闲</span>)</span>
                                </div>
                                <div class="adm-meter-track">
                                    <div class="adm-meter-fill" v-bind:class="info.memoryUsage < 15 ? 'is-warn' : ''" v-bind:style="{ width: Math.min(100, Math.max(4, 100 - (Number(info.memoryUsage) || 0))) + '%' }"></div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- 应用程序路径与网络信息 -->
                <div class="adm-info-card">
                    <div class="adm-info-card-head">
                        <span><i class="fa fa-globe"></i>应用程序信息</span>
                        <span class="label label-info">Web Host</span>
                    </div>
                    <div class="adm-info-card-body">
                        <ul class="adm-kv-list">
                            <li>
                                <span class="adm-kv-key">程序绝对路径</span>
                                <span class="adm-kv-val">@ViewBag.contentPath</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">站点物理路径</span>
                                <span class="adm-kv-val">@ViewBag.rootPath</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">服务器地址</span>
                                <span class="adm-kv-val">@Utils.GetServerUrl():@(ViewBag.port)</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">当前客户端 IP</span>
                                <span class="adm-kv-val">@(Utils.GetIP())</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- .NET 运行时与进程内存 -->
                <div class="adm-info-card">
                    <div class="adm-info-card-head">
                        <span><i class="fa fa-microchip"></i>.NET 运行环境</span>
                        <button type="button" class="btn btn-sm btn-outline btn-primary" onclick="doMemoryFree()" title="点击执行 GC 释放进程内存">
                            <i class="fa fa-recycle"></i> 释放内存
                        </button>
                    </div>
                    <div class="adm-info-card-body">
                        <ul class="adm-kv-list">
                            <li>
                                <span class="adm-kv-key">.NET 版本</span>
                                <span class="adm-kv-val">@Environment.Version</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">运行环境</span>
                                <span class="adm-kv-val"><span class="label label-primary">@env.EnvironmentName</span></span>
                            </li>
                            <li>
                                <span class="adm-kv-key">进程内存 (工作/提交)</span>
                                <span class="adm-kv-val">{{info.workingSet64}} / {{info.privateMemorySize64}}</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">GC 托管内存</span>
                                <span class="adm-kv-val">{{info.gCMemory}}</span>
                            </li>
                            <li>
                                <span class="adm-kv-key">进程启动时间</span>
                                <span class="adm-kv-val">@Process.GetCurrentProcess().StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>

    <script>
        function openMenuTab(href) {
            try {
                if (parent && parent.$) {
                    var $link = parent.$('#side-menu a.J_menuItem').filter(function () {
                        return ($(this).attr('href') || '').toLowerCase() === href.toLowerCase();
                    }).first();
                    if ($link.length) {
                        $link.trigger('click');
                        return;
                    }
                }
            } catch (e) { }
            window.location.href = href;
        }

        function openQuickDialog(id, title, url) {
            if (top && typeof top.showDialog === 'function') {
                top.showDialog(id, title, url, 0, 0);
            } else {
                window.location.href = url;
            }
        }

        function doMemoryFree() {
            var loading = layer.load(2, { shade: [0.2, '#000'] });
            $.ajax({
                type: "POST",
                url: "/AdminCP/Index/DoMemoryFree",
                data: { __RequestVerificationToken: csrfToken },
                dataType: "JSON",
                success: function (data) {
                    layer.close(loading);
                    if (data.status === "success") {
                        layer.msg(data.message || '内存释放完成', { time: 1200 }, function () {
                            window.location.reload();
                        });
                    } else {
                        layer.alert(data.message || '操作失败', { icon: 2 });
                    }
                },
                error: function () {
                    layer.close(loading);
                    layer.alert('执行错误，请联系管理员！', { icon: 2 });
                }
            });
        }

        if (document.getElementById('app')) {
            new Vue({
                el: '#app',
                data: function () {
                    return {
                        info: {
                            cpuRate: 0,
                            availableMemory: '-',
                            memoryUsage: 0,
                            workingSet64: '-',
                            privateMemorySize64: '-',
                            gCMemory: '-'
                        }
                    };
                },
                created: function () {
                    this.getMachineInfo();
                },
                methods: {
                    getMachineInfo: function () {
                        var that = this;
                        $.ajax({
                            type: "POST",
                            url: '/AdminCP/Index/GetMachineInfo?rnd=' + Math.random(),
                            data: { __RequestVerificationToken: csrfToken },
                            success: function (data) {
                                if (data && data.status === "success") {
                                    that.info = data.detail;
                                    setTimeout(function () {
                                        that.getMachineInfo();
                                    }, 10000);
                                }
                            }
                        });
                    }
                }
            });
        }
    </script>
    <script src="~/hplus/js/common.js" asp-append-version="true"></script>
</body>
</html>
