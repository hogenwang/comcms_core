@model List<COMCMS.Core.AdminMenu>
@{
    Layout = null;
    Admin admin = ViewBag.Admin;
    string adminName = string.IsNullOrWhiteSpace(admin?.UserName) ? "Admin" : admin.UserName;
    string avatarChar = adminName.Substring(0, 1).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="renderer" content="webkit">
    <title>后台管理中心 - COMCMS</title>
    <script>
        if (window.top !== window.self) { window.top.location = window.location; }
        (function () {
            try {
                var t = localStorage.getItem('comcms_admin_theme') === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>
    <link href="~/lib/bootstrap5/bootstrap.min.css" rel="stylesheet" />
    <link href="~/hplus/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/hplus/css/animate.min.css" rel="stylesheet" />
    <link href="~/hplus/js/plugins/metisMenu/metisMenu.min.css" rel="stylesheet" />
    <link href="~/css/admin-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-bs3-compat.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-modern.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="admin-shell-body fixed-sidebar full-height-layout">
    <div id="wrapper" class="admin-shell">
        <div class="admin-sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- 左侧现代深海导航栏 -->
        <nav class="admin-sidebar navbar-default navbar-static-side" role="navigation">
            <div class="admin-sidebar-brand">
                <div class="admin-brand-mark">
                    <img alt="COMCMS" src="~/images/logo.png" onerror="this.style.display='none'" />
                </div>
                <div class="admin-brand-text">
                    <strong>COMCMS</strong>
                    <span>Admin Console</span>
                </div>
            </div>

            <div class="sidebar-collapse">
                <ul class="nav" id="side-menu">
                    <li style="display:none">
                        <a href="#">
                            <i class="fa fa-home"></i>
                            <span class="nav-label">权限操作</span>
                            <span class="fa arrow"></span>
                        </a>
                        <ul class="nav nav-second-level">
                            <li>@Html.ActionLink("事件权限管理", "EventKey", "Permission", null, new { @class = "J_menuItem" })</li>
                            <li>@Html.ActionLink("后台栏目管理", "AdminMenuList", "Permission", null, new { @class = "J_menuItem" })</li>
                        </ul>
                    </li>

                    @foreach (var m1 in Model)
                    {
                        if (m1.PId == 0 && m1.IsHide != 1)
                        {
                            var l2 = Model.FindAll(s => s.PId == m1.Id && s.IsHide != 1);
                            bool hasChildren = l2 != null && l2.Count > 0;
                            <li>
                                <a href="@(m1.Link == "#" ? "javascript:;" : "/AdminCP/" + m1.Link)" id="@m1.MenuKey" class="@(m1.Link != "#" ? "J_menuItem" : "")" title="@m1.MenuName">
                                    @if (!string.IsNullOrWhiteSpace(m1.ClassName))
                                    {
                                        <i class="fa @m1.ClassName"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-circle-o"></i>
                                    }
                                    <span class="nav-label">@m1.MenuName</span>
                                    @if (hasChildren)
                                    {
                                        <span class="fa arrow"></span>
                                    }
                                </a>
                                @if (hasChildren)
                                {
                                    <ul class="nav nav-second-level">
                                        @foreach (var m2 in l2)
                                        {
                                            <li>
                                                <a class="J_menuItem" href="/AdminCP/@m2.Link">@m2.MenuName</a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        </nav>

        <!-- 右侧主工作区 -->
        <div id="page-wrapper" class="admin-main-col">
            <!-- 极简现代顶栏 -->
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button type="button" class="admin-icon-btn navbar-minimalize" title="折叠/展开菜单" aria-label="折叠/展开菜单">
                        <i class="fa fa-bars"></i>
                    </button>
                    <span class="admin-topbar-status">
                        <span class="admin-status-dot"></span>
                        <span>管理控制台</span>
                    </span>
                </div>

                <div class="admin-topbar-right">
                    <button type="button" class="admin-theme-toggle" data-admin-theme-toggle title="切换浅色/深色风格">
                        <i class="fa fa-moon-o"></i>
                        <span>深色风格</span>
                    </button>

                    <button type="button" class="admin-icon-btn" onclick="refreshCurrentTab()" title="刷新当前页" aria-label="刷新当前页">
                        <i class="fa fa-refresh"></i>
                    </button>

                    <button type="button" class="admin-icon-btn hidden-xs" onclick="requestFullScreen(document.documentElement)" title="全屏切换" aria-label="全屏切换">
                        <i class="fa fa-arrows-alt"></i>
                    </button>

                    <a href="/" target="_blank" rel="noopener noreferrer" class="admin-topbar-link hidden-xs" title="访问站点前台">
                        <i class="fa fa-external-link"></i>
                        <span>站点首页</span>
                    </a>

                    <div class="dropdown">
                        <button type="button" class="admin-user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-user-avatar">@avatarChar</span>
                            <span>@adminName</span>
                            <span class="admin-user-role hidden-xs">(@(admin?.Roles?.RoleName ?? "管理员"))</span>
                            <i class="fa fa-angle-down" style="font-size:12px;opacity:.7;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="J_menuItem" href="/AdminCP/Member/EditMe">
                                    <i class="fa fa-key"></i> 修改密码
                                </a>
                            </li>
                            <li class="divider"></li>
                            <li>
                                <form method="post" action="/AdminCP/Login/Logout" class="dropdown-logout-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-logout-button">
                                        <i class="fa fa-sign-out"></i> 安全退出
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- 现代多标签栏 -->
            <div class="content-tabs">
                <button type="button" class="roll-nav roll-left J_tabLeft" title="向左滚动标签">
                    <i class="fa fa-angle-double-left"></i>
                </button>
                <nav class="page-tabs J_menuTabs">
                    <div class="page-tabs-content">
                        <a href="javascript:;" class="active J_menuTab" data-id="/AdminCP/Index/Main">首页</a>
                    </div>
                </nav>
                <button type="button" class="roll-nav roll-right J_tabRight" title="向右滚动标签">
                    <i class="fa fa-angle-double-right"></i>
                </button>
                <div class="btn-group roll-nav roll-right">
                    <button type="button" class="dropdown J_tabClose" data-bs-toggle="dropdown" aria-expanded="false">
                        标签操作 <i class="fa fa-angle-down"></i>
                    </button>
                    <ul role="menu" class="dropdown-menu dropdown-menu-end">
                        <li class="J_tabShowActive"><a href="javascript:;"><i class="fa fa-crosshairs"></i> 定位当前选项卡</a></li>
                        <li class="divider"></li>
                        <li class="J_tabCloseAll"><a href="javascript:;"><i class="fa fa-times-circle-o"></i> 关闭全部选项卡</a></li>
                        <li class="J_tabCloseOther"><a href="javascript:;"><i class="fa fa-minus-circle"></i> 关闭其他选项卡</a></li>
                    </ul>
                </div>
                <form method="post" action="/AdminCP/Login/Logout" class="admin-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="J_tabExit" title="安全退出">
                        <i class="fa fa-sign-out"></i>
                        <span class="hidden-xs">退出</span>
                    </button>
                </form>
            </div>

            <!-- 子页面 iframe 承载区 -->
            <div class="J_mainContent" id="content-main">
                <iframe class="J_iframe" name="iframe0" width="100%" height="100%" src="/AdminCP/Index/Main" frameborder="0" data-id="/AdminCP/Index/Main" seamless></iframe>
            </div>

            <!-- 极简页脚 -->
            <footer class="admin-footer">
                <span>&copy; 2010-@DateTime.Now.Year COMCMS Enterprise Admin</span>
                <span class="hidden-xs">Horizon UI · Bootstrap 5</span>
            </footer>
        </div>
    </div>

    <script src="~/js/jquery-3.min.js"></script>
    <script src="~/lib/bootstrap5/bootstrap.bundle.min.js"></script>
    <script src="~/js/layer/layer.js"></script>
    <script src="~/js/rtpost.js" asp-append-version="true"></script>
    <script src="~/hplus/js/plugins/metisMenu/metisMenu.min.js"></script>
    <script src="~/hplus/js/hplus.js" asp-append-version="true"></script>
    <script src="~/hplus/js/contabs.js" asp-append-version="true"></script>
    <script src="~/js/admin-modern.js" asp-append-version="true"></script>
    <script>
        function requestFullScreen(element) {
            if (document.fullscreenElement) {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                }
            } else {
                var requestMethod = element.requestFullscreen || element.webkitRequestFullscreen || element.mozRequestFullScreen || element.msRequestFullscreen;
                if (requestMethod) {
                    requestMethod.call(element);
                }
            }
        }
    </script>
</body>
</html>
