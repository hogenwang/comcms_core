function rotateImage(deg) {
    if (activeTool !== 'crop') {
        activateTool('crop');
    }
    pushHistory();
    rotation = (rotation + deg + 360) % 360;
    resetCropRect();
    markToolDirty('crop');
    drawCanvas();
}

function flipImage(dir) {
    if (activeTool !== 'crop') {
        activateTool('crop');
    }
    pushHistory();
    if (dir === 'h') flipH = !flipH;
    else flipV = !flipV;
    markToolDirty('crop');
    drawCanvas();
}

function zoomCanvas(delta) {
    var oldZoom = zoomLevel;
    var newZoom = Math.max(0.1, Math.min(5, zoomLevel + delta));
    if (newZoom === oldZoom) return;

    var ratio = oldZoom / newZoom;
    var newW = cropRect.w * ratio;
    var newH = cropRect.h * ratio;

    if (newW > 1 || newH > 1) {
        var maxRatio = Math.min(1 / cropRect.w, 1 / cropRect.h);
        ratio = Math.min(ratio, maxRatio);
        newW = cropRect.w * ratio;
        newH = cropRect.h * ratio;
        newZoom = oldZoom / ratio;
    }

    var cx = cropRect.x + cropRect.w / 2;
    var cy = cropRect.y + cropRect.h / 2;
    cropRect.w = newW;
    cropRect.h = newH;
    cropRect.x = Math.max(0, Math.min(1 - newW, cx - newW / 2));
    cropRect.y = Math.max(0, Math.min(1 - newH, cy - newH / 2));

    zoomLevel = newZoom;
    updateZoomText();
    drawCanvas();
}

function updateZoomText() {
    document.getElementById('zoomText').textContent = Math.round(zoomLevel * 100) + '%';
}

function setAspectRatio(btn, ratio) {
    if (activeTool !== 'crop') return;
    var btns = document.querySelectorAll('.aspect-btn');
    btns.forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    aspectRatio = ratio;
    if (ratio === -1) aspectRatio = displayW / displayH;

    if (ratio === 0) resetCropRect();
    else applyCropAspectRatio();

    markToolDirty('crop');
    drawCanvas();
}

function applyCropAspectRatio() {
    var r = aspectRatio;
    if (r <= 0) return;

    var canvasRatio = displayW / displayH;
    var cw, ch;
    if (r > canvasRatio) {
        cw = 1;
        ch = (displayW / r) / displayH;
    } else {
        ch = 1;
        cw = (displayH * r) / displayW;
    }
    cropRect.w = cw;
    cropRect.h = ch;
    cropRect.x = (1 - cw) / 2;
    cropRect.y = (1 - ch) / 2;
}

function onDimChange(axis) {
    if (activeTool !== 'crop') return;
    var w = parseInt(document.getElementById('dimWidth').value, 10) || displayW;
    var h = parseInt(document.getElementById('dimHeight').value, 10) || displayH;
    cropRect.w = Math.min(w / displayW, 1);
    cropRect.h = Math.min(h / displayH, 1);
    cropRect.x = Math.max(0, (1 - cropRect.w) / 2);
    cropRect.y = Math.max(0, (1 - cropRect.h) / 2);
    markToolDirty('crop');
    drawCanvas();
}

