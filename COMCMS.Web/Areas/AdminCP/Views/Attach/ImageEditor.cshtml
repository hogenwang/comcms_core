function addTextItem() {
    if (activeTool !== 'text') return;
    pushHistory();
    var txt = document.getElementById('textContent').value || '示例文本';
    var color = document.getElementById('textColor').value || '#111111';
    var font = document.getElementById('textFont').value || 'Microsoft YaHei';
    var size = Math.max(8, Math.min(300, parseInt(document.getElementById('textSize').value, 10) || 36));
    var bold = document.getElementById('textBold').classList.contains('active');
    var italic = document.getElementById('textItalic').classList.contains('active');
    var strokeColor = document.getElementById('textStrokeColor').value || '#000000';
    var strokeWidth = Math.max(0, parseInt(document.getElementById('textStrokeWidth').value, 10) || 0);
    var bgColor = document.getElementById('textBgColor').value || '#ffffff';
    var bgOpacity = parseInt(document.getElementById('textBgOpacity').value, 10) || 0;
    var rotate = parseInt(document.getElementById('textRotate').value, 10) || 0;

    var item = {
        id: textSeedId++,
        text: txt,
        color: color,
        font: font,
        size: size,
        bold: bold,
        italic: italic,
        strokeColor: strokeColor,
        strokeWidth: strokeWidth,
        bgColor: bgColor,
        bgOpacity: bgOpacity,
        rotate: rotate,
        x: 0.2,
        y: 0.2,
        zIndex: _nextZIndex++
    };
    textItems.push(item);
    selectedTextId = item.id;
    drawCanvas();
}

function removeTextItem() {
    if (activeTool !== 'text') return;
    if (!textItems.length) return;
    pushHistory();
    if (selectedTextId) {
        textItems = textItems.filter(function(t) { return t.id !== selectedTextId; });
    } else {
        textItems.pop();
    }
    if (textItems.length) selectedTextId = textItems[textItems.length - 1].id;
    else selectedTextId = 0;

    drawCanvas();
}

function hitTestText(px, py, canvasW, canvasH) {
    var canvas = document.getElementById('mainCanvas');
    var ctx = canvas.getContext('2d');
    for (var i = textItems.length - 1; i >= 0; i--) {
        var item = textItems[i];
        ctx.save();
        var fontStr = '';
        if (item.italic) fontStr += 'italic ';
        if (item.bold) fontStr += 'bold ';
        fontStr += item.size + 'px "' + item.font + '"';
        ctx.font = fontStr;
        var width = Math.max(20, ctx.measureText(item.text).width);
        ctx.restore();

        var x = item.x * canvasW;
        var y = item.y * canvasH;
        var h = item.size + 8;
        if (px >= x - 5 && px <= x + width + 5 && py >= y - 5 && py <= y + h + 5) {
            return item;
        }
    }
    return null;
}

function hitTestStroke(px, py, canvasW, canvasH) {
    for (var i = strokes.length - 1; i >= 0; i--) {
        var s = strokes[i];
        if (!s.points || !s.points.length) continue;
        var threshold = s.size / 2 + 8;
        for (var j = 0; j < s.points.length; j++) {
            var sx = s.points[j].x * canvasW;
            var sy = s.points[j].y * canvasH;
            if (Math.abs(px - sx) <= threshold && Math.abs(py - sy) <= threshold) {
                return s;
            }
        }
    }
    return null;
}

// ==================== 指针工具 ====================
function refreshPointerList() {
    var list = document.getElementById('pointerItemList');
    if (!list) return;
    list.innerHTML = '';

    textItems.forEach(function(item) {
        var div = createPointerListItem('text', item.id, '<i class="fa fa-font"></i>', item.text || '(空文本)');
        list.appendChild(div);
    });

    strokes.forEach(function(stroke) {
        var icon = stroke.type === 'eraser' ? '<i class="fa fa-eraser"></i>' :
                   stroke.type === 'mosaic' ? '<i class="fa fa-th"></i>' : '<i class="fa fa-pencil"></i>';
        var label = stroke.type === 'eraser' ? '橡皮擦 #' + stroke.id :
                    stroke.type === 'mosaic' ? '马赛克 #' + stroke.id : '笔迹 #' + stroke.id;
        var div = createPointerListItem('draw', stroke.id, icon, label);
        list.appendChild(div);
    });

    shapes.forEach(function(shape) {
        var icons = { rect: 'fa-square-o', circle: 'fa-circle-o', line: 'fa-minus', arrow: 'fa-long-arrow-right' };
        var names = { rect: '矩形', circle: '椭圆', line: '直线', arrow: '箭头' };
        var icon = '<i class="fa ' + (icons[shape.type] || 'fa-square-o') + '"></i>';
        var label = (names[shape.type] || '形状') + ' #' + shape.id;
        var div = createPointerListItem('shape', shape.id, icon, label);
        list.appendChild(div);
    });

    imageItems.forEach(function(img) {
        var div = createPointerListItem('image', img.id, '<i class="fa fa-picture-o"></i>', '图片 #' + img.id);
        list.appendChild(div);
    });

    var totalCount = textItems.length + strokes.length + shapes.length + imageItems.length;
    var empty = document.getElementById('pointerEmpty');
    if (empty) empty.style.display = totalCount === 0 ? 'block' : 'none';

    updatePointerProps();
}

function createPointerListItem(type, id, iconHtml, label) {
    var div = document.createElement('div');
    div.className = 'pointer-item';
    if ((type === 'text' && id === selectedTextId && selectedItemType === 'text') ||
        (type === 'draw' && id === selectedStrokeId && selectedItemType === 'draw') ||
        (type === 'shape' && id === selectedShapeId && selectedItemType === 'shape') ||
        (type === 'image' && id === selectedImageId && selectedItemType === 'image')) {
        div.className += ' selected';
    }
    div.innerHTML = '<span class="item-icon">' + iconHtml + '</span>' +
        '<span class="item-text">' + escapeHtml(label) + '</span>' +
        '<div class="item-order-btns">' +
            '<button class="item-order-btn" title="置顶"><i class="fa fa-angle-double-up"></i></button>' +
            '<button class="item-order-btn" title="上移"><i class="fa fa-angle-up"></i></button>' +
            '<button class="item-order-btn" title="下移"><i class="fa fa-angle-down"></i></button>' +
            '<button class="item-order-btn" title="置底"><i class="fa fa-angle-double-down"></i></button>' +
        '</div>' +
        '<button class="item-del" title="删除"><i class="fa fa-times"></i></button>';

    (function(t, i) {
        div.onclick = function() { selectPointerItem(t, i); };
        var orderBtns = div.querySelectorAll('.item-order-btn');
        orderBtns[0].onclick = function(e) { e.stopPropagation(); movePointerItem(t, i, 'top'); };
        orderBtns[1].onclick = function(e) { e.stopPropagation(); movePointerItem(t, i, 'up'); };
        orderBtns[2].onclick = function(e) { e.stopPropagation(); movePointerItem(t, i, 'down'); };
        orderBtns[3].onclick = function(e) { e.stopPropagation(); movePointerItem(t, i, 'bottom'); };
        div.querySelector('.item-del').onclick = function(e) {
            e.stopPropagation();
            deletePointerItem(t, i);
        };
    })(type, id);

    return div;
}

function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
}

function selectPointerItem(type, id) {
    selectedItemType = type;
    if (type === 'text') {
        selectedTextId = id; selectedStrokeId = 0; selectedShapeId = 0; selectedImageId = 0;
    } else if (type === 'draw') {
        selectedStrokeId = id; selectedTextId = 0; selectedShapeId = 0; selectedImageId = 0;
    } else if (type === 'shape') {
        selectedShapeId = id; selectedTextId = 0; selectedStrokeId = 0; selectedImageId = 0;
    } else if (type === 'image') {
        selectedImageId = id; selectedTextId = 0; selectedStrokeId = 0; selectedShapeId = 0;
    }
    refreshPointerList();
    drawCanvas();
}

function deletePointerItem(type, id) {
    pushHistory();
    if (type === 'text') {
        textItems = textItems.filter(function(t) { return t.id !== id; });
        if (selectedTextId === id) { selectedTextId = 0; selectedItemType = null; }
    } else if (type === 'draw') {
        strokes = strokes.filter(function(s) { return s.id !== id; });
        if (selectedStrokeId === id) { selectedStrokeId = 0; selectedItemType = null; }
    } else if (type === 'shape') {
        shapes = shapes.filter(function(s) { return s.id !== id; });
        if (selectedShapeId === id) { selectedShapeId = 0; selectedItemType = null; }
    } else if (type === 'image') {
        imageItems = imageItems.filter(function(x) { return x.id !== id; });
        if (selectedImageId === id) { selectedImageId = 0; selectedItemType = null; }
    }
    refreshPointerList();
    drawCanvas();
}

function deleteSelectedItem() {
    if (selectedItemType === 'text' && selectedTextId) {
        deletePointerItem('text', selectedTextId);
    } else if (selectedItemType === 'draw' && selectedStrokeId) {
        deletePointerItem('draw', selectedStrokeId);
    } else if (selectedItemType === 'shape' && selectedShapeId) {
        deletePointerItem('shape', selectedShapeId);
    } else if (selectedItemType === 'image' && selectedImageId) {
        deletePointerItem('image', selectedImageId);
    }
}

function updatePointerProps() {
    var textProps = document.getElementById('pointerTextProps');
    var drawProps = document.getElementById('pointerDrawProps');
    var shapeProps = document.getElementById('pointerShapeProps');
    var imageProps = document.getElementById('pointerImageProps');
    var emptyHint = document.getElementById('pointerEmpty');
    if (!textProps || !drawProps || !emptyHint) return;

    textProps.style.display = 'none';
    drawProps.style.display = 'none';
    if (shapeProps) shapeProps.style.display = 'none';
    if (imageProps) imageProps.style.display = 'none';

    if (selectedItemType === 'text' && selectedTextId) {
        var item = textItems.find(function(t) { return t.id === selectedTextId; });
        if (item) {
            textProps.style.display = 'block';
            document.getElementById('ptrTextContent').value = item.text;
            document.getElementById('ptrTextColor').value = item.color;
            document.getElementById('ptrTextFont').value = item.font;
            document.getElementById('ptrTextSize').value = item.size;
            document.getElementById('ptrTextBold').classList.toggle('active', !!item.bold);
            document.getElementById('ptrTextItalic').classList.toggle('active', !!item.italic);
            document.getElementById('ptrTextStrokeColor').value = item.strokeColor || '#000000';
            document.getElementById('ptrTextStrokeWidth').value = item.strokeWidth || 0;
            document.getElementById('ptrTextBgColor').value = item.bgColor || '#ffffff';
            document.getElementById('ptrTextBgOpacity').value = item.bgOpacity || 0;
            document.getElementById('ptrTextRotate').value = item.rotate || 0;
            emptyHint.style.display = 'none';
            return;
        }
    }

    if (selectedItemType === 'draw' && selectedStrokeId) {
        var stroke = strokes.find(function(s) { return s.id === selectedStrokeId; });
        if (stroke) {
            drawProps.style.display = 'block';
            document.getElementById('ptrDrawColor').value = stroke.color || '#ff2d20';
            document.getElementById('ptrDrawSize').value = stroke.size || 4;
            emptyHint.style.display = 'none';
            return;
        }
    }

    if (selectedItemType === 'shape' && selectedShapeId && shapeProps) {
        var shape = shapes.find(function(s) { return s.id === selectedShapeId; });
        if (shape) {
            shapeProps.style.display = 'block';
            document.getElementById('ptrShapeStrokeColor').value = shape.color || '#ff2d20';
            document.getElementById('ptrShapeLineWidth').value = shape.lineWidth || 2;
            document.getElementById('ptrShapeFillColor').value = shape.fillColor || '#ffffff';
            document.getElementById('ptrShapeFillOpacity').value = shape.fillOpacity || 0;
            emptyHint.style.display = 'none';
            return;
        }
    }

    if (selectedItemType === 'image' && selectedImageId && imageProps) {
        var imgItem = imageItems.find(function(x) { return x.id === selectedImageId; });
        if (imgItem) {
            imageProps.style.display = 'block';
            var dw = displayW || 1;
            var dh = displayH || 1;
            document.getElementById('ptrImgWidth').value = Math.round(imgItem.w * dw);
            document.getElementById('ptrImgHeight').value = Math.round(imgItem.h * dh);
            emptyHint.style.display = 'none';
            return;
        }
    }

    var totalCount = textItems.length + strokes.length + shapes.length + imageItems.length;
    if (totalCount === 0) emptyHint.style.display = 'block';
}

function onPointerTextChange() {
    if (!selectedTextId) return;
    var item = textItems.find(function(t) { return t.id === selectedTextId; });
    if (!item) return;
    item.text = document.getElementById('ptrTextContent').value || '';
    item.color = document.getElementById('ptrTextColor').value || '#111111';
    item.font = document.getElementById('ptrTextFont').value || 'Microsoft YaHei';
    item.size = Math.max(8, Math.min(300, parseInt(document.getElementById('ptrTextSize').value, 10) || 36));
    item.strokeColor = document.getElementById('ptrTextStrokeColor').value || '#000000';
    item.strokeWidth = Math.max(0, parseInt(document.getElementById('ptrTextStrokeWidth').value, 10) || 0);
    item.bgColor = document.getElementById('ptrTextBgColor').value || '#ffffff';
    item.bgOpacity = parseInt(document.getElementById('ptrTextBgOpacity').value, 10) || 0;
    item.rotate = parseInt(document.getElementById('ptrTextRotate').value, 10) || 0;
    refreshPointerList();
    drawCanvas();
}

function onPointerDrawChange() {
    if (!selectedStrokeId) return;
    var stroke = strokes.find(function(s) { return s.id === selectedStrokeId; });
    if (!stroke) return;
    stroke.color = document.getElementById('ptrDrawColor').value || '#ff2d20';
    stroke.size = Math.max(1, Math.min(80, parseInt(document.getElementById('ptrDrawSize').value, 10) || 4));
    drawCanvas();
}

// ==================== 鼠标交互 ====================
(function() {
    var dragging = false;
    var dragType = '';
    var startX = 0, startY = 0;
    var startRect = null;
    var draggingText = null;
    var draggingStroke = null;
    var draggingShape = null;
    var draggingImage = null;
    var draggingImageCorner = null; // 'tl'|'tr'|'bl'|'br' 缩放把手
    var imgDragStart = null; // {x,y,w,h,nx,ny} snapshot when drag starts

    function getCanvasPoint(e) {
        var canvas = document.getElementById('mainCanvas');
        var rect = canvas.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        if (x < 0 || y < 0 || x > rect.width || y > rect.height) return null;
        return {
            x: x,
            y: y,
            nx: rect.width > 0 ? x / rect.width : 0,
            ny: rect.height > 0 ? y / rect.height : 0
        };
    }

    // 马赛克：采样 canvas 当前位置像素做像素化，生成一个 patch（dataUrl）
    function captureMosaicPatch(pt, canvas, blockSz, brushSz) {
        var cw = canvas.width, ch = canvas.height;
        var px = Math.round(pt.nx * cw);
        var py = Math.round(pt.ny * ch);
        var half = Math.round(brushSz / 2);
        var x0 = Math.max(0, px - half);
        var y0 = Math.max(0, py - half);
        var w = Math.min(brushSz, cw - x0);
        var h = Math.min(brushSz, ch - y0);
        if (w <= 0 || h <= 0) return null;

        // 缩小尺寸实现像素化
        var smallW = Math.max(1, Math.round(w / blockSz));
        var smallH = Math.max(1, Math.round(h / blockSz));
        var tmpSmall = document.createElement('canvas');
        tmpSmall.width = smallW; tmpSmall.height = smallH;
        var sCtx = tmpSmall.getContext('2d');
        sCtx.imageSmoothingEnabled = false;
        // 从离屏 stroke Canvas 之前的状态采样（主 canvas 反映了底图+已有stroke）
        sCtx.drawImage(canvas, x0, y0, w, h, 0, 0, smallW, smallH);

        // 放大回原尺寸
        var tmpBig = document.createElement('canvas');
        tmpBig.width = w; tmpBig.height = h;
        var bCtx = tmpBig.getContext('2d');
        bCtx.imageSmoothingEnabled = false;
        bCtx.drawImage(tmpSmall, 0, 0, smallW, smallH, 0, 0, w, h);

        return {
            nx: x0 / cw,
            ny: y0 / ch,
            bw: w,
            bh: h,
            canvas: tmpBig,
            dataUrl: tmpBig.toDataURL('image/png')
        };
    }

    document.addEventListener('mousedown', function(e) {
        var pt = getCanvasPoint(e);
        if (!pt) return;

        // 指针工具：选中或拖动
        if (activeTool === 'pointer') {
            var canvas = document.getElementById('mainCanvas');
            // 优先检测图片角点（缩放）
            var imgCorner = hitTestImageCorner(pt.x, pt.y, canvas.width, canvas.height);
            if (imgCorner) {
                draggingImageCorner = imgCorner;
                var selImg = imageItems.find(function(x) { return x.id === selectedImageId; });
                draggingImage = selImg;
                imgDragStart = { x: selImg.x, y: selImg.y, w: selImg.w, h: selImg.h, nx: pt.nx, ny: pt.ny };
                dragging = true; dragType = 'imgResize';
                e.preventDefault(); return;
            }
            var textHit = hitTestText(pt.x, pt.y, canvas.width, canvas.height);
            if (textHit) {
                selectPointerItem('text', textHit.id);
                draggingText = textHit;
                dragging = true; dragType = 'pointerText';
                startX = pt.nx; startY = pt.ny;
                e.preventDefault(); return;
            }
            var strokeHit = hitTestStroke(pt.x, pt.y, canvas.width, canvas.height);
            if (strokeHit) {
                selectPointerItem('draw', strokeHit.id);
                draggingStroke = strokeHit;
                dragging = true; dragType = 'pointerStroke';
                startX = pt.nx; startY = pt.ny;
                e.preventDefault(); return;
            }
            var shapeHit = hitTestShape(pt.x, pt.y, canvas.width, canvas.height);
            if (shapeHit) {
                selectPointerItem('shape', shapeHit.id);
                draggingShape = shapeHit;
                dragging = true; dragType = 'pointerShape';
                startX = pt.nx; startY = pt.ny;
                e.preventDefault(); return;
            }
            var imageHit = hitTestImage(pt.x, pt.y, canvas.width, canvas.height);
            if (imageHit) {
                selectPointerItem('image', imageHit.id);
                draggingImage = imageHit;
                imgDragStart = { x: imageHit.x, y: imageHit.y, w: imageHit.w, h: imageHit.h, nx: pt.nx, ny: pt.ny };
                dragging = true; dragType = 'pointerImage';
                e.preventDefault(); return;
            }
            // 点击空白区域取消选择
            selectedTextId = 0; selectedStrokeId = 0; selectedShapeId = 0; selectedImageId = 0; selectedItemType = null;
            refreshPointerList(); drawCanvas(); return;
        }

        // 形状工具
        if (activeTool === 'shape') {
            onShapeConfigChange();
            currentShape = {
                id: shapeSeedId++,
                type: shapeType,
                x1: pt.nx, y1: pt.ny,
                x2: pt.nx, y2: pt.ny,
                color: shapeStrokeColor,
                lineWidth: shapeLineWidth,
                fillColor: shapeFillColor,
                fillOpacity: shapeFillOpacity,
                zIndex: _nextZIndex++
            };
            dragging = true; dragType = 'shape';
            e.preventDefault(); return;
        }

        // 书写工具
        if (activeTool === 'draw') {
            onDrawConfigChange();
            currentStroke = {
                id: strokeSeedId++,
                color: brushColor,
                size: brushSize,
                type: brushType,
                points: [{ x: pt.nx, y: pt.ny }]
            };
            strokes.push(currentStroke);
            dragging = true; dragType = 'draw';
            e.preventDefault(); return;
        }

        // 橡皮擦工具
        if (activeTool === 'eraser') {
            onEraserConfigChange();
            currentStroke = {
                id: strokeSeedId++,
                color: 'rgba(0,0,0,1)',
                size: eraserSize,
                type: eraserShape,
                points: [{ x: pt.nx, y: pt.ny }]
            };
            strokes.push(currentStroke);
            dragging = true; dragType = 'eraser';
            e.preventDefault(); return;
        }

        // 马赛克工具
        if (activeTool === 'mosaic') {
            onMosaicConfigChange();
            currentStroke = {
                id: strokeSeedId++,
                type: 'mosaic',
                patches: []
            };
            strokes.push(currentStroke);
            var canvas = document.getElementById('mainCanvas');
            var patch = captureMosaicPatch(pt, canvas, mosaicBlockSize, mosaicBrushSize);
            if (patch) currentStroke.patches.push(patch);
            dragging = true; dragType = 'mosaic';
            e.preventDefault(); return;
        }

        // 文本工具：选中现有文本或取消选择
        if (activeTool === 'text') {
            var canvas = document.getElementById('mainCanvas');
            var hit = hitTestText(pt.x, pt.y, canvas.width, canvas.height);
            if (hit) {
                selectedTextId = hit.id;
                populateTextInputsFromSelected();
                draggingText = hit;
                dragging = true; dragType = 'text';
                startX = pt.nx; startY = pt.ny;
                drawCanvas(); e.preventDefault();
            } else {
                selectedTextId = 0;
                drawCanvas();
            }
            return;
        }

        if (activeTool !== 'crop') return;

        var target = e.target;
        var sel = document.getElementById('cropSelection');
        if (target.classList.contains('crop-handle')) {
            dragging = true;
            dragType = target.dataset.handle;
            startX = e.clientX; startY = e.clientY;
            startRect = Object.assign({}, cropRect);
            e.preventDefault();
        } else if (target === sel || sel.contains(target)) {
            dragging = true; dragType = 'move';
            startX = e.clientX; startY = e.clientY;
            startRect = Object.assign({}, cropRect);
            e.preventDefault();
        }
    });

    document.addEventListener('mousemove', function(e) {
        // 画笔工具光标预览（无论是否正在拖动）
        var cursEl = document.getElementById('brushCursor');
        if (cursEl) {
            var canvasCurs = document.getElementById('mainCanvas');
            var rCurs = canvasCurs.getBoundingClientRect();
            var cx2 = e.clientX - rCurs.left;
            var cy2 = e.clientY - rCurs.top;
            var inCanvas = cx2 >= 0 && cy2 >= 0 && cx2 <= rCurs.width && cy2 <= rCurs.height;
            if ((activeTool === 'draw' || activeTool === 'eraser') && inCanvas) {
                var scaleX = rCurs.width / (canvasCurs.width || 1);
                var curSize = activeTool === 'eraser' ? eraserSize : brushSize;
                var displaySize = curSize * scaleX;
                cursEl.style.display = 'block';
                cursEl.style.left = cx2 + 'px';
                cursEl.style.top = cy2 + 'px';
                cursEl.style.width = displaySize + 'px';
                cursEl.style.height = displaySize + 'px';
                var isSquareCursor = (activeTool === 'eraser' && eraserShape === 'eraser-square') || (activeTool === 'draw' && brushType === 'square');
                if (isSquareCursor) {
                    cursEl.classList.add('square');
                } else {
                    cursEl.classList.remove('square');
                }
            } else {
                cursEl.style.display = 'none';
            }
        }

        if (!dragging) {
            // 马赛克工具移动时也显示虚线预览
            if (activeTool === 'mosaic') {
                var ptM = getCanvasPoint(e);
                mosaicPreviewPt = ptM;
                drawCanvas();
            }
            return;
        }

        if ((dragType === 'draw' || dragType === 'eraser') && currentStroke) {
            var pt = getCanvasPoint(e);
            if (!pt) return;
            currentStroke.points.push({ x: pt.nx, y: pt.ny });
            drawCanvas(); return;
        }

        if (dragType === 'mosaic' && currentStroke) {
            var pt = getCanvasPoint(e);
            if (!pt) return;
            mosaicPreviewPt = pt;
            var canvas = document.getElementById('mainCanvas');
            var patch = captureMosaicPatch(pt, canvas, mosaicBlockSize, mosaicBrushSize);
            if (patch) currentStroke.patches.push(patch);
            drawCanvas(); return;
        }

        if (dragType === 'shape' && currentShape) {
            var ptS = getCanvasPoint(e);
            if (!ptS) return;
            currentShape.x2 = ptS.nx;
            currentShape.y2 = ptS.ny;
            drawCanvas(); return;
        }

        if ((dragType === 'text' || dragType === 'pointerText') && draggingText) {
            var ptText = getCanvasPoint(e);
            if (!ptText) return;
            var dx = ptText.nx - startX;
            var dy = ptText.ny - startY;
            draggingText.x = Math.max(0, Math.min(1, draggingText.x + dx));
            draggingText.y = Math.max(0, Math.min(1, draggingText.y + dy));
            startX = ptText.nx; startY = ptText.ny;
            drawCanvas(); return;
        }

        if (dragType === 'pointerStroke' && draggingStroke) {
            var ptStroke = getCanvasPoint(e);
            if (!ptStroke) return;
            var sdx = ptStroke.nx - startX;
            var sdy = ptStroke.ny - startY;
            draggingStroke.points = draggingStroke.points.map(function(pt) {
                return {
                    x: Math.max(0, Math.min(1, pt.x + sdx)),
                    y: Math.max(0, Math.min(1, pt.y + sdy))
                };
            });
            if (draggingStroke.type === 'mosaic' && draggingStroke.patches) {
                draggingStroke.patches = draggingStroke.patches.map(function(p) {
                    return Object.assign({}, p, {
                        nx: Math.max(0, Math.min(1, p.nx + sdx)),
                        ny: Math.max(0, Math.min(1, p.ny + sdy))
                    });
                });
            }
            startX = ptStroke.nx; startY = ptStroke.ny;
            drawCanvas(); return;
        }

        if (dragType === 'pointerShape' && draggingShape) {
            var ptShape = getCanvasPoint(e);
            if (!ptShape) return;
            var ddx = ptShape.nx - startX;
            var ddy = ptShape.ny - startY;
            draggingShape.x1 = Math.max(0, Math.min(1, draggingShape.x1 + ddx));
            draggingShape.y1 = Math.max(0, Math.min(1, draggingShape.y1 + ddy));
            draggingShape.x2 = Math.max(0, Math.min(1, draggingShape.x2 + ddx));
            draggingShape.y2 = Math.max(0, Math.min(1, draggingShape.y2 + ddy));
            startX = ptShape.nx; startY = ptShape.ny;
            drawCanvas(); return;
        }

        // 图片拖动移动
        if (dragType === 'pointerImage' && draggingImage && imgDragStart) {
            var ptImg = getCanvasPoint(e);
            if (!ptImg) return;
            var ddx2 = ptImg.nx - imgDragStart.nx;
            var ddy2 = ptImg.ny - imgDragStart.ny;
            draggingImage.x = Math.max(0, Math.min(1 - draggingImage.w, imgDragStart.x + ddx2));
            draggingImage.y = Math.max(0, Math.min(1 - draggingImage.h, imgDragStart.y + ddy2));
            drawCanvas();
            updatePointerProps();
            return;
        }

        // 图片角点缩放
        if (dragType === 'imgResize' && draggingImage && imgDragStart) {
            var ptRes = getCanvasPoint(e);
            if (!ptRes) return;
            var rdx = ptRes.nx - imgDragStart.nx;
            var rdy = ptRes.ny - imgDragStart.ny;
            var origW = imgDragStart.w;
            var origH = imgDragStart.h;
            var origX = imgDragStart.x;
            var origY = imgDragStart.y;
            var aspect = origW / origH;
            var corner = draggingImageCorner;
            var newW = origW, newH = origH, newX = origX, newY = origY;

            if (corner === 'br') {
                newW = Math.max(0.02, origW + rdx);
                newH = newW / aspect;
            } else if (corner === 'tr') {
                newW = Math.max(0.02, origW + rdx);
                newH = newW / aspect;
                newY = origY + origH - newH;
            } else if (corner === 'bl') {
                newW = Math.max(0.02, origW - rdx);
                newH = newW / aspect;
                newX = origX + origW - newW;
            } else if (corner === 'tl') {
                newW = Math.max(0.02, origW - rdx);
                newH = newW / aspect;
                newX = origX + origW - newW;
                newY = origY + origH - newH;
            }

            draggingImage.x = Math.max(0, newX);
            draggingImage.y = Math.max(0, newY);
            draggingImage.w = Math.min(1 - draggingImage.x, newW);
            draggingImage.h = Math.min(1 - draggingImage.y, newH);
            drawCanvas();
            updatePointerProps();
            return;
        }

        if (activeTool !== 'crop') return;

        var canvas = document.getElementById('mainCanvas');
        var cw = canvas.width, ch = canvas.height;
        if (!cw || !ch) return;
        var dx = (e.clientX - startX) / cw;
        var dy = (e.clientY - startY) / ch;

        if (dragType === 'move') {
            cropRect.x = Math.max(0, Math.min(1 - startRect.w, startRect.x + dx));
            cropRect.y = Math.max(0, Math.min(1 - startRect.h, startRect.y + dy));
        } else {
            var r = startRect;
            var nx = r.x, ny = r.y, nw = r.w, nh = r.h;

            if (dragType.indexOf('r') !== -1) nw = Math.max(0.02, Math.min(1 - r.x, r.w + dx));
            if (dragType.indexOf('l') !== -1) {
                var newX = Math.max(0, r.x + dx);
                nw = r.w + (r.x - newX);
                nx = newX;
                if (nw < 0.02) { nw = 0.02; nx = r.x + r.w - 0.02; }
            }
            if (dragType.indexOf('b') !== -1) nh = Math.max(0.02, Math.min(1 - r.y, r.h + dy));
            if (dragType.indexOf('t') !== -1 && dragType !== 'tr') {
                var newY = Math.max(0, r.y + dy);
                nh = r.h + (r.y - newY);
                ny = newY;
                if (nh < 0.02) { nh = 0.02; ny = r.y + r.h - 0.02; }
            }

            if (dragType === 'tr') {
                nw = Math.max(0.02, Math.min(1 - r.x, r.w + dx));
                var newYtr = Math.max(0, r.y + dy);
                nh = r.h + (r.y - newYtr);
                ny = newYtr;
                if (nh < 0.02) { nh = 0.02; ny = r.y + r.h - 0.02; }
            }

            if (aspectRatio > 0) {
                var targetRatio = aspectRatio * (displayH / displayW);
                if (dragType.indexOf('r') !== -1 || dragType.indexOf('l') !== -1) nh = nw / targetRatio;
                else nw = nh * targetRatio;

                if (nx + nw > 1) { nw = 1 - nx; nh = nw / targetRatio; }
                if (ny + nh > 1) { nh = 1 - ny; nw = nh * targetRatio; }
            }

            cropRect.x = nx; cropRect.y = ny; cropRect.w = nw; cropRect.h = nh;
        }

        markToolDirty('crop');
        drawCanvas();
    });

    document.addEventListener('mouseup', function() {
        if (dragging) {
            // 书写完成一笔 → 推历史
            if (dragType === 'draw' && currentStroke) {
                if (currentStroke.points && currentStroke.points.length >= 2) {
                    pushHistory();
                }
                markToolDirty('draw');
            }
            // 橡皮擦完成一笔 → 推历史
            if (dragType === 'eraser' && currentStroke) {
                if (currentStroke.points && currentStroke.points.length >= 2) {
                    pushHistory();
                }
                markToolDirty('eraser');
            }
            // 马赛克完成一笔 → 推历史
            if (dragType === 'mosaic' && currentStroke) {
                if (currentStroke.patches && currentStroke.patches.length > 0) {
                    pushHistory();
                }
                markToolDirty('mosaic');
                mosaicPreviewPt = null;
            }
            // 形状完成 → 加入 shapes 数组，推历史
            if (dragType === 'shape' && currentShape) {
                var dx = Math.abs(currentShape.x2 - currentShape.x1);
                var dy = Math.abs(currentShape.y2 - currentShape.y1);
                if (dx > 0.005 || dy > 0.005) {
                    shapes.push(currentShape);
                    pushHistory();
                    markToolDirty('shape');
                }
                currentShape = null;
            }
            // 图片拖动/缩放完成 → 推历史
            if ((dragType === 'pointerImage' || dragType === 'imgResize') && draggingImage) {
                pushHistory();
            }
        }
        dragging = false; dragType = '';
        currentStroke = null;
        draggingText = null;
        draggingStroke = null;
        draggingShape = null;
        draggingImage = null;
        draggingImageCorner = null;
        imgDragStart = null;
    });
    // 鼠标离开 canvas 隐藏画笔光标和马赛克预览
    document.getElementById('mainCanvas').addEventListener('mouseleave', function() {
        var cursEl = document.getElementById('brushCursor');
        if (cursEl) cursEl.style.display = 'none';
        if (activeTool === 'mosaic' && !dragging) {
            mosaicPreviewPt = null;
            drawCanvas();
        }
    });
    // 右键菜单：在画布上右击命中图层元素时弹出操作面板
    document.getElementById('mainCanvas').addEventListener('contextmenu', function(e) {
        e.preventDefault();
        var pt = getCanvasPoint(e);
        if (!pt) return;
        var canvas = document.getElementById('mainCanvas');
        var imgHit    = hitTestImage(pt.x, pt.y, canvas.width, canvas.height);
        var shapeHit  = !imgHit    && hitTestShape(pt.x, pt.y, canvas.width, canvas.height);
        var strokeHit = !shapeHit  && hitTestStroke(pt.x, pt.y, canvas.width, canvas.height);
        var textHit   = !strokeHit && hitTestText(pt.x, pt.y, canvas.width, canvas.height);
        if (!imgHit && !shapeHit && !strokeHit && !textHit) return;
        if (imgHit)         { _ctxMenuType = 'image'; _ctxMenuId = imgHit.id; }
        else if (shapeHit)  { _ctxMenuType = 'shape'; _ctxMenuId = shapeHit.id; }
        else if (strokeHit) { _ctxMenuType = 'draw';  _ctxMenuId = strokeHit.id; }
        else                { _ctxMenuType = 'text';  _ctxMenuId = textHit.id; }
        selectPointerItem(_ctxMenuType, _ctxMenuId);
        var menu = document.getElementById('canvasContextMenu');
        var mx = e.clientX, my = e.clientY;
        if (mx + 160 > window.innerWidth)  mx = window.innerWidth  - 164;
        if (my + 200 > window.innerHeight) my = window.innerHeight - 204;
        menu.style.left = mx + 'px';
        menu.style.top  = my + 'px';
        menu.style.display = 'block';
    });
    // 点击其他区域关闭右键菜单
    document.addEventListener('click', function() {
        var m = document.getElementById('canvasContextMenu');
        if (m) m.style.display = 'none';
    });
})();
// ==================== 右键菜单操作 ====================
function ctxMenuAction(action) {
    document.getElementById('canvasContextMenu').style.display = 'none';
    if (!_ctxMenuType || !_ctxMenuId) return;
    if (action === 'delete') {
        deletePointerItem(_ctxMenuType, _ctxMenuId);
        pushHistory();
    } else {
        movePointerItem(_ctxMenuType, _ctxMenuId, action);
    }
    drawCanvas();
}
// ==================== 生成最终图片 ====================
function generateFinalImage(outputW, outputH, options) {
    options = options || {};
    var useCrop = options.useCrop !== false;
    var includeDraw = options.includeDraw === true;
    var includeText = options.includeText === true;
    var includeShapes = options.includeShapes !== false; // 默认包含形状

    // 滤镜处理：支持单个或多个
    var filterCss = 'none';
    if (options.filters && options.filters.length) {
        filterCss = getCombinedFilterCss(options.filters);
    } else if (options.filterName && options.filterName !== 'none') {
        filterCss = getFilterCss(options.filterName);
    }

    var canvas = document.createElement('canvas');
    var ctx = canvas.getContext('2d');

    var cx = useCrop ? Math.round(cropRect.x * displayW) : 0;
    var cy = useCrop ? Math.round(cropRect.y * displayH) : 0;
    var cw = useCrop ? Math.round(cropRect.w * displayW) : displayW;
    var ch = useCrop ? Math.round(cropRect.h * displayH) : displayH;
    if (cw <= 0) cw = displayW;
    if (ch <= 0) ch = displayH;

    var finalW = outputW || cw;
    var finalH = outputH || ch;
    canvas.width = finalW;
    canvas.height = finalH;

    var tmpCanvas = document.createElement('canvas');
    var tmpCtx = tmpCanvas.getContext('2d');
    tmpCanvas.width = displayW;
    tmpCanvas.height = displayH;

    tmpCtx.save();
    tmpCtx.translate(displayW / 2, displayH / 2);
    tmpCtx.rotate(rotation * Math.PI / 180);
    tmpCtx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
    tmpCtx.filter = filterCss;

    var srcW, srcH;
    if (rotation === 90 || rotation === 270) {
        srcW = displayH; srcH = displayW;
    } else {
        srcW = displayW; srcH = displayH;
    }
    tmpCtx.drawImage(originalImage, -srcW / 2, -srcH / 2, srcW, srcH);
    tmpCtx.restore();

    if (includeDraw) drawStrokesToContext(tmpCtx, tmpCanvas.width, tmpCanvas.height);
    // 导出时也使用统一图层排序
    drawUnifiedLayers(tmpCtx, tmpCanvas.width, tmpCanvas.height, false, {
        includeShapes: includeShapes,
        includeText: includeText
    });

    ctx.drawImage(tmpCanvas, cx, cy, cw, ch, 0, 0, finalW, finalH);

    var mimeType = (fileExt === '.png') ? 'image/png' : 'image/jpeg';
    var quality = (fileExt === '.png') ? undefined : 0.92;
    return canvas.toDataURL(mimeType, quality);
}

// ==================== 保存对话框 ====================
function showSaveDialog() {
    // 仅检查裁剪、滤镜和画面调整的dirty，书写、文本、形状作为独立图层无需确认
    if (toolDirty.crop || toolDirty.filter || toolDirty.adjust) {
        alert('裁剪、滤镜或画面调整还有未确认的修改，请先确认。');
        return;
    }

    var cw = Math.round(cropRect.w * displayW) || displayW;
    var ch = Math.round(cropRect.h * displayH) || displayH;

    var now = new Date();
    var dateStr = now.getFullYear() +
        String(now.getMonth() + 1).padStart(2, '0') +
        String(now.getDate()).padStart(2, '0') + '_' +
        String(now.getHours()).padStart(2, '0') +
        String(now.getMinutes()).padStart(2, '0') +
        String(now.getSeconds()).padStart(2, '0');

    document.getElementById('saveFileName').value = fileNameBase + '-' + dateStr;
    document.getElementById('saveOverwrite').checked = false;
    document.getElementById('saveWidth').value = cw;
    document.getElementById('saveHeight').value = ch;
    saveResizeLock = true;
    document.getElementById('saveResizeLock').classList.add('active');
    document.getElementById('saveResizeLock').innerHTML = '<i class="fa fa-lock"></i>';

    var previewData = generateFinalImage(cw, ch, { useCrop: true, includeDraw: true, includeText: true });
    document.getElementById('savePreviewImg').src = previewData;

    document.getElementById('saveDialogOverlay').classList.add('show');
}

function closeSaveDialog() {
    document.getElementById('saveDialogOverlay').classList.remove('show');
}

function toggleSaveResizeLock() {
    saveResizeLock = !saveResizeLock;
    var btn = document.getElementById('saveResizeLock');
    if (saveResizeLock) {
        btn.classList.add('active');
        btn.innerHTML = '<i class="fa fa-lock"></i>';
    } else {
        btn.classList.remove('active');
        btn.innerHTML = '<i class="fa fa-unlock"></i>';
    }
}

function onSaveResize(axis) {
    var w = parseInt(document.getElementById('saveWidth').value, 10) || 1;
    var h = parseInt(document.getElementById('saveHeight').value, 10) || 1;
    var cw = Math.round(cropRect.w * displayW) || displayW;
    var ch = Math.round(cropRect.h * displayH) || displayH;
    var ratio = cw / ch;

    if (saveResizeLock) {
        if (axis === 'w') {
            h = Math.round(w / ratio);
            document.getElementById('saveHeight').value = h;
        } else {
            w = Math.round(h * ratio);
            document.getElementById('saveWidth').value = w;
        }
    }
}

function doSave() {
    if (toolDirty.crop || toolDirty.filter || toolDirty.adjust) {
        alert('存在未确认的裁剪、滤镜或画面调整修改，请先确认后再保存。');
        return;
    }

    var fileName = document.getElementById('saveFileName').value.trim();
    if (!fileName) {
        alert('请输入文件名');
        return;
    }
    fileName = fileName.replace(/[^\u4e00-\u9fa5a-zA-Z0-9_\-\.]/g, '_');

    var overwrite = document.getElementById('saveOverwrite').checked;
    var outputW = parseInt(document.getElementById('saveWidth').value, 10) || 0;
    var outputH = parseInt(document.getElementById('saveHeight').value, 10) || 0;

    var imageData = generateFinalImage(outputW, outputH, { useCrop: true, includeDraw: true, includeText: true });

    var saveBtn = document.querySelector('.save-dialog-footer .btn-save');
    var originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> 保存中...';
    saveBtn.disabled = true;

    var csrfInput = document.querySelector("input[name='__RequestVerificationToken']");
    var xhr = new XMLHttpRequest();
    xhr.open('POST', @COMCMS.Web.Common.SafeScriptJson.Serialize(appBase + "/AdminCP/Attach/SaveEditedImage"), true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    if (csrfInput && csrfInput.value) {
        xhr.setRequestHeader('RequestVerificationToken', csrfInput.value);
    }
    xhr.onload = function() {
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;
        try {
            var res = JSON.parse(xhr.responseText);
            if (res.code === 0) {
                if (window.opener && !window.opener.closed) {
                    try { window.opener.refreshFiles(); } catch (e) { }
                    window.close();
                } else if (window.parent && window.parent !== window) {
                    try { window.parent.refreshFiles(); } catch (e) { }
                    try {
                        var idx = window.parent.layer.getFrameIndex(window.name);
                        window.parent.layer.close(idx);
                    } catch (e) { }
                } else {
                    window.close();
                }
            } else {
                alert(res.message);
            }
        } catch (e) {
            alert('保存失败');
        }
    };
    xhr.onerror = function() {
        saveBtn.innerHTML = originalText;
        saveBtn.disabled = false;
        alert('网络错误');
    };

    var params = 'path=' + encodeURIComponent(imagePath) +
        '&fileName=' + encodeURIComponent(fileName) +
        '&ext=' + encodeURIComponent(fileExt) +
        '&overwrite=' + overwrite +
        '&originalPath=' + encodeURIComponent(imagePath) +
        '&imageData=' + encodeURIComponent(imageData);
    xhr.send(params);
}

// ==================== 键盘快捷键 ====================
document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
    if (e.key === 'Escape') closeSaveDialog();
    // Delete 键删除选中的对象
    if (e.key === 'Delete' && activeTool === 'pointer') {
        deleteSelectedItem();
    }
    // Ctrl+Z 撤销
    if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
        e.preventDefault();
        undoAction();
    }
    // Ctrl+Y / Ctrl+Shift+Z 重做
    if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.shiftKey && e.key === 'z'))) {
        e.preventDefault();
        redoAction();
    }
});

// ==================== 窗口大小变化时重绘 ====================
window.addEventListener('resize', function() {
    drawCanvas();
});
    </script>
</body>
</html>
