    <script>
// ==================== 状态变量 ====================
var originalImage = new Image();
var imagePath = @COMCMS.Web.Common.SafeScriptJson.Serialize(imagePath ?? "");
var fileNameBase = @COMCMS.Web.Common.SafeScriptJson.Serialize(fileName ?? "");
var fileExt = @COMCMS.Web.Common.SafeScriptJson.Serialize(fileExt ?? "");

var rotation = 0;
var flipH = false;
var flipV = false;
var zoomLevel = 1;
var cropActive = false;
var aspectRatio = 0;
var saveResizeLock = true;

var activeTool = '';
var toolDirty = { crop: false, filter: false, draw: false, text: false, adjust: false, shape: false, eraser: false, mosaic: false };

// 滤镜：多选叠加
var selectedFilters = [];

// 书写：带ID
var brushColor = '#ff2d20';
var brushSize = 4;
var brushType = 'round';
var strokes = [];
var currentStroke = null;
var strokeSeedId = 1;
var selectedStrokeId = 0;

// 文本
var textItems = [];
var selectedTextId = 0;
var textSeedId = 1;

// 指针
var selectedItemType = null; // 'text' | 'draw' | 'shape'

// 撤销/重做
var historyStack = [];
var historyIndex = -1;

// 画面调整
var adjustValues = { brightness: 0, contrast: 0, saturation: 0, warmth: 0, sharpen: 0 };

// 形状
var shapes = [];
var shapeSeedId = 1;
var selectedShapeId = 0;
var shapeType = 'rect';
var shapeStrokeColor = '#ff2d20';
var shapeLineWidth = 2;
var shapeFillColor = '#ffffff';
var shapeFillOpacity = 0;
var currentShape = null;

// 马赛克块大小
var mosaicBlockSize = 12;
// 橡皮擦独立参数
var eraserSize = 20;
var eraserShape = 'eraser';
// 马赛克独立参数
var mosaicBrushSize = 40;

// 图片图层
var imageItems = [];
var imageSeedId = 1;
var selectedImageId = 0;
// 马赛克预览点（拖动时显示当前块区域）
var mosaicPreviewPt = null;
// 右键菜单当前命中项（全局，供 ctxMenuAction 使用）
var _ctxMenuType = null, _ctxMenuId = 0;
// 统一图层 z-index 计数器（形状/图片/文本共享，笔迹例外）
var _nextZIndex = 1;

// stroke 离屏 Canvas（用于橡皮擦 destination-out 效果）
var strokeOffCanvas = document.createElement('canvas');
var strokeOffCtx = strokeOffCanvas.getContext('2d');

var cropRect = { x: 0, y: 0, w: 1, h: 1 };
var displayW = 0, displayH = 0;

// ==================== 初始化 ====================
originalImage.crossOrigin = 'anonymous';
originalImage.onload = function() {
    document.getElementById('infoWidth').textContent = originalImage.naturalWidth + ' px';
    document.getElementById('infoHeight').textContent = originalImage.naturalHeight + ' px';
    resetAll();
    // 推入初始状态，使撤销不会变资源
    pushHistory();
    updateUndoRedoBtns();
};
originalImage.src = @COMCMS.Web.Common.SafeScriptJson.Serialize(imageUrl ?? "") + '?t=' + new Date().getTime();

function markToolDirty(toolName) {
    toolDirty[toolName] = true;
}

function clearToolDirty(toolName) {
    toolDirty[toolName] = false;
}

// ==================== A1 撤销 / 重做 ====================
function captureHistoryState() {
    var state = {
        imageSrc: originalImage.src,
        rotation: rotation,
        flipH: flipH,
        flipV: flipV,
        selectedFilters: selectedFilters.slice(),
        strokes: JSON.parse(JSON.stringify(strokes.map(function(s) {
            // mosaic patches 中的 pixelData 单独用 dataUrl 保存
            if (s.type === 'mosaic' && s.patches) {
                var safeSt = JSON.parse(JSON.stringify(s));
                safeSt.patches = s.patches.map(function(p) {
                    return { nx: p.nx, ny: p.ny, bw: p.bw, bh: p.bh, dataUrl: p.dataUrl };
                });
                return safeSt;
            }
            return s;
        }))),
        textItems: JSON.parse(JSON.stringify(textItems)),
        shapes: JSON.parse(JSON.stringify(shapes)),
        imageItems: imageItems.map(function(img) { return { id: img.id, src: img.src, x: img.x, y: img.y, w: img.w, h: img.h, naturalW: img.naturalW, naturalH: img.naturalH, zIndex: img.zIndex }; }),
        displayW: displayW,
        displayH: displayH
    };
    return state;
}

function pushHistory() {
    // 截断重做分支
    if (historyIndex < historyStack.length - 1) {
        historyStack.splice(historyIndex + 1);
    }
    historyStack.push(captureHistoryState());
    if (historyStack.length > 20) historyStack.shift();
    historyIndex = historyStack.length - 1;
    updateUndoRedoBtns();
}

function restoreHistoryState(state) {
    var img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = function() {
        originalImage = img;
        rotation = state.rotation;
        flipH = state.flipH;
        flipV = state.flipV;
        selectedFilters = state.selectedFilters.slice();
        textItems = JSON.parse(JSON.stringify(state.textItems));
        shapes = JSON.parse(JSON.stringify(state.shapes));
        // 恢复 mosaic patches 中的 imageData
        strokes = state.strokes.map(function(s) {
            if (s.type === 'mosaic' && s.patches) {
                s.patches = s.patches.map(function(p) {
                    var img2 = new Image();
                    img2.src = p.dataUrl;
                    return p;
                });
            }
            return s;
        });
        // 恢复图片图层
        imageItems = (state.imageItems || []).map(function(item) {
            var imgEl = new Image();
            imgEl.crossOrigin = 'anonymous';
            imgEl.src = item.src;
            return { id: item.id, src: item.src, x: item.x, y: item.y, w: item.w, h: item.h, naturalW: item.naturalW, naturalH: item.naturalH, el: imgEl, zIndex: item.zIndex || 0 };
        });
        // 恢复后同步 _nextZIndex，确保新建项不会与已有 zIndex 冲突
        var maxZ = 0;
        shapes.forEach(function(s) { if ((s.zIndex || 0) > maxZ) maxZ = s.zIndex; });
        imageItems.forEach(function(img) { if ((img.zIndex || 0) > maxZ) maxZ = img.zIndex; });
        textItems.forEach(function(t) { if ((t.zIndex || 0) > maxZ) maxZ = t.zIndex; });
        _nextZIndex = maxZ + 1;
        displayW = state.displayW;
        displayH = state.displayH;
        selectedTextId = 0; selectedStrokeId = 0; selectedShapeId = 0; selectedImageId = 0; selectedItemType = null;
        updateUndoRedoBtns();
        drawCanvas();
    };
    img.src = state.imageSrc;
}

function undoAction() {
    if (historyIndex <= 0) return;
    historyIndex--;
    restoreHistoryState(historyStack[historyIndex]);
}

function redoAction() {
    if (historyIndex >= historyStack.length - 1) return;
    historyIndex++;
    restoreHistoryState(historyStack[historyIndex]);
}

function updateUndoRedoBtns() {
    var btnUndo = document.getElementById('btnUndo');
    var btnRedo = document.getElementById('btnRedo');
    if (btnUndo) btnUndo.disabled = (historyIndex <= 0);
    if (btnRedo) btnRedo.disabled = (historyIndex >= historyStack.length - 1);
}

// ==================== A2 画面调整 ====================
function onAdjustChange() {
    adjustValues.brightness = parseInt(document.getElementById('adjBrightness').value, 10) || 0;
    adjustValues.contrast = parseInt(document.getElementById('adjContrast').value, 10) || 0;
    adjustValues.saturation = parseInt(document.getElementById('adjSaturation').value, 10) || 0;
    adjustValues.warmth = parseInt(document.getElementById('adjWarmth').value, 10) || 0;
    adjustValues.sharpen = parseInt(document.getElementById('adjSharpen').value, 10) || 0;
    document.getElementById('adjBrightnessVal').textContent = adjustValues.brightness;
    document.getElementById('adjContrastVal').textContent = adjustValues.contrast;
    document.getElementById('adjSaturationVal').textContent = adjustValues.saturation;
    document.getElementById('adjWarmthVal').textContent = adjustValues.warmth;
    document.getElementById('adjSharpenVal').textContent = adjustValues.sharpen;
    markToolDirty('adjust');
    drawCanvas();
}

function getAdjustFilterCss() {
    var parts = [];
    var b = adjustValues.brightness;
    var c = adjustValues.contrast;
    var s = adjustValues.saturation;
    var w = adjustValues.warmth;
    // brightness: -100~100 → 0~2
    parts.push('brightness(' + (1 + b / 100).toFixed(3) + ')');
    // contrast: -100~100 → 0~2
    parts.push('contrast(' + (1 + c / 100).toFixed(3) + ')');
    // saturation: -100~100 → 0~2
    parts.push('saturate(' + Math.max(0, 1 + s / 100).toFixed(3) + ')');
    // warmth: -50~50 → hue-rotate -30deg ~ +30deg
    parts.push('hue-rotate(' + (w * 0.6).toFixed(1) + 'deg)');
    return parts.join(' ');
}

function applySharpenToCanvas(ctx, w, h, amount) {
    if (amount <= 0) return;
    var imgData = ctx.getImageData(0, 0, w, h);
    var src = imgData.data;
    var dst = new Uint8ClampedArray(src.length);
    var str = amount / 100 * 2; // 卷积强度 0~2
    // 3x3 unsharp mask 卷积核
    for (var y = 1; y < h - 1; y++) {
        for (var x = 1; x < w - 1; x++) {
            var i = (y * w + x) * 4;
            for (var c = 0; c < 3; c++) {
                var center = src[i + c];
                var avg = (src[((y-1)*w+(x-1))*4+c] + src[((y-1)*w+x)*4+c] + src[((y-1)*w+(x+1))*4+c] +
                           src[(y*w+(x-1))*4+c]                              + src[(y*w+(x+1))*4+c] +
                           src[((y+1)*w+(x-1))*4+c] + src[((y+1)*w+x)*4+c] + src[((y+1)*w+(x+1))*4+c]) / 8;
                dst[i + c] = Math.max(0, Math.min(255, Math.round(center + str * (center - avg))));
            }
            dst[i + 3] = src[i + 3];
        }
    }
    // 边缘直接复制
    for (var k = 0; k < src.length; k += 4) {
        var px = (k / 4) % w;
        var py = Math.floor(k / 4 / w);
        if (px === 0 || px === w - 1 || py === 0 || py === h - 1) {
            dst[k] = src[k]; dst[k+1] = src[k+1]; dst[k+2] = src[k+2]; dst[k+3] = src[k+3];
        }
    }
    imgData.data.set(dst);
    ctx.putImageData(imgData, 0, 0);
}

function confirmAdjustTool(autoConfirm) {
    var hasAdjust = Object.keys(adjustValues).some(function(k) { return adjustValues[k] !== 0; });
    if (!hasAdjust) {
        clearToolDirty('adjust');
        if (!autoConfirm) hidePanelAfterConfirm();
        return;
    }
    pushHistory();
    var canvas = document.createElement('canvas');
    canvas.width = displayW;
    canvas.height = displayH;
    var ctx = canvas.getContext('2d');
    ctx.save();
    ctx.translate(displayW / 2, displayH / 2);
    ctx.rotate(rotation * Math.PI / 180);
    ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
    ctx.filter = getAdjustFilterCss();
    var sw = (rotation === 90 || rotation === 270) ? displayH : displayW;
    var sh = (rotation === 90 || rotation === 270) ? displayW : displayH;
    ctx.drawImage(originalImage, -sw / 2, -sh / 2, sw, sh);
    ctx.restore();
    // 不能在 filter 状态下 getImageData，需重置 filter 后再 sharpen
    if (adjustValues.sharpen > 0) {
        var tmp = document.createElement('canvas');
        tmp.width = displayW; tmp.height = displayH;
        var tCtx = tmp.getContext('2d');
        tCtx.drawImage(canvas, 0, 0);
        applySharpenToCanvas(tCtx, displayW, displayH, adjustValues.sharpen);
        canvas = tmp;
    }
    var dataUrl = canvas.toDataURL((fileExt === '.png') ? 'image/png' : 'image/jpeg', 0.92);
    applyImageDataToOriginal(dataUrl, function() {
        rotation = 0; flipH = false; flipV = false;
        adjustValues = { brightness: 0, contrast: 0, saturation: 0, warmth: 0, sharpen: 0 };
        ['adjBrightness','adjContrast','adjSaturation','adjWarmth','adjSharpen'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.value = 0;
        });
        ['adjBrightnessVal','adjContrastVal','adjSaturationVal','adjWarmthVal','adjSharpenVal'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.textContent = '0';
        });
        clearToolDirty('adjust');
        if (!autoConfirm) hidePanelAfterConfirm();
        drawCanvas();
    });
}

// ==================== B3 文本样式辅助 ====================
function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16);
    var g = parseInt(hex.slice(3, 5), 16);
    var b = parseInt(hex.slice(5, 7), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha.toFixed(3) + ')';
}

function toggleTextBold() {
    if (!selectedTextId) return;
    var item = textItems.find(function(t) { return t.id === selectedTextId; });
    if (!item) return;
    item.bold = !item.bold;
    document.getElementById('textBold').classList.toggle('active', item.bold);
    drawCanvas();
}

function toggleTextItalic() {
    if (!selectedTextId) return;
    var item = textItems.find(function(t) { return t.id === selectedTextId; });
    if (!item) return;
    item.italic = !item.italic;
    document.getElementById('textItalic').classList.toggle('active', item.italic);
    drawCanvas();
}

function togglePtrTextBold() {
    if (!selectedTextId) return;
    var item = textItems.find(function(t) { return t.id === selectedTextId; });
    if (!item) return;
    item.bold = !item.bold;
    document.getElementById('ptrTextBold').classList.toggle('active', item.bold);
    drawCanvas();
}

function togglePtrTextItalic() {
    if (!selectedTextId) return;
    var item = textItems.find(function(t) { return t.id === selectedTextId; });
    if (!item) return;
    item.italic = !item.italic;
    document.getElementById('ptrTextItalic').classList.toggle('active', item.italic);
    drawCanvas();
}

// ==================== B1 形状工具 ====================
function setShapeType(type) {
    shapeType = type;
    ['Rect','Circle','Line','Arrow'].forEach(function(t) {
        var btn = document.getElementById('shapeType' + t);
        if (btn) btn.classList.toggle('active', t.toLowerCase() === type);
    });
}

function onShapeConfigChange() {
    shapeStrokeColor = document.getElementById('shapeStrokeColor').value || '#ff2d20';
    shapeLineWidth = Math.max(1, parseInt(document.getElementById('shapeLineWidth').value, 10) || 2);
    shapeFillColor = document.getElementById('shapeFillColor').value || '#ffffff';
    shapeFillOpacity = parseInt(document.getElementById('shapeFillOpacity').value, 10) || 0;
}

function confirmShapeTool(autoConfirm) {
    clearToolDirty('shape');
    if (!autoConfirm) hidePanelAfterConfirm();
}

function drawShapesToContext(ctx, width, height, isExport) {
    if (!shapes.length && !currentShape) return;
    var list = isExport ? shapes : shapes;
    list.forEach(function(shape) {
        drawSingleShape(ctx, shape, width, height, !isExport && activeTool === 'pointer' && shape.id === selectedShapeId);
    });
    if (!isExport && currentShape) {
        drawSingleShape(ctx, currentShape, width, height, false);
    }
}

function drawSingleShape(ctx, shape, width, height, showSelection) {
    var x1 = shape.x1 * width, y1 = shape.y1 * height;
    var x2 = shape.x2 * width, y2 = shape.y2 * height;
    ctx.save();
    ctx.strokeStyle = shape.color;
    ctx.lineWidth = shape.lineWidth;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    // 填充
    if (shape.fillOpacity > 0) {
        ctx.fillStyle = hexToRgba(shape.fillColor, shape.fillOpacity / 100);
    }

    if (shape.type === 'rect') {
        var rx = Math.min(x1, x2), ry = Math.min(y1, y2);
        var rw = Math.abs(x2 - x1), rh = Math.abs(y2 - y1);
        if (shape.fillOpacity > 0) ctx.fillRect(rx, ry, rw, rh);
        ctx.strokeRect(rx, ry, rw, rh);
    } else if (shape.type === 'circle') {
        var cx = (x1 + x2) / 2, cy = (y1 + y2) / 2;
        var rx2 = Math.abs(x2 - x1) / 2, ry2 = Math.abs(y2 - y1) / 2;
        ctx.beginPath();
        ctx.ellipse(cx, cy, Math.max(1, rx2), Math.max(1, ry2), 0, 0, Math.PI * 2);
        if (shape.fillOpacity > 0) ctx.fill();
        ctx.stroke();
    } else if (shape.type === 'line') {
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
    } else if (shape.type === 'arrow') {
        var adx = x2 - x1, ady = y2 - y1;
        var alen = Math.sqrt(adx * adx + ady * ady);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
        if (alen > 10) {
            var headLen = Math.min(20, alen * 0.3);
            var angle = Math.atan2(ady, adx);
            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
            ctx.stroke();
        }
    }

    if (showSelection) {
        var bx = Math.min(x1, x2) - 5, by = Math.min(y1, y2) - 5;
        var bw = Math.abs(x2 - x1) + 10, bh = Math.abs(y2 - y1) + 10;
        ctx.strokeStyle = '#1c84c6';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 3]);
        ctx.strokeRect(bx, by, bw, bh);
        ctx.setLineDash([]);
    }
    ctx.restore();
}

function hitTestShape(px, py, canvasW, canvasH) {
    for (var i = shapes.length - 1; i >= 0; i--) {
        var s = shapes[i];
        var x1 = s.x1 * canvasW, y1 = s.y1 * canvasH;
        var x2 = s.x2 * canvasW, y2 = s.y2 * canvasH;
        var bx = Math.min(x1, x2) - 8, by = Math.min(y1, y2) - 8;
        var bw = Math.abs(x2 - x1) + 16, bh = Math.abs(y2 - y1) + 16;
        if (px >= bx && px <= bx + bw && py >= by && py <= by + bh) return s;
    }
    return null;
}

function onPointerShapeChange() {
    if (!selectedShapeId) return;
    var shape = shapes.find(function(s) { return s.id === selectedShapeId; });
    if (!shape) return;
    shape.color = document.getElementById('ptrShapeStrokeColor').value || '#ff2d20';
    shape.lineWidth = Math.max(1, parseInt(document.getElementById('ptrShapeLineWidth').value, 10) || 2);
    shape.fillColor = document.getElementById('ptrShapeFillColor').value || '#ffffff';
    shape.fillOpacity = parseInt(document.getElementById('ptrShapeFillOpacity').value, 10) || 0;
    drawCanvas();
}

// ==================== 图片图层 ====================
function openAttachForImage() {
    var baseUrl = @COMCMS.Web.Common.SafeScriptJson.Serialize(appBase);
    var url = baseUrl + '/AdminCP/Attach/Index?mode=select&callback=onAttachImageSelected&type=image';
    window.open(url, 'attachPicker', 'width=900,height=640,scrollbars=yes,resizable=yes');
}

// 由附件管理器弹窗回调
function onAttachImageSelected(src) {
    var img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = function() {
        var nw = img.naturalWidth || 200;
        var nh = img.naturalHeight || 150;
        // 默认以图片原始尺寸的一半（不超过画布的 60%）放置在中央
        var dw = displayW || 800;
        var dh = displayH || 600;
        var scale = Math.min(1, dw * 0.6 / nw, dh * 0.6 / nh);
        var w = nw * scale / dw;
        var h = nh * scale / dh;
        var x = (1 - w) / 2;
        var y = (1 - h) / 2;
        var item = { id: imageSeedId++, src: src, x: x, y: y, w: w, h: h, naturalW: nw, naturalH: nh, el: img, zIndex: _nextZIndex++ };
        imageItems.push(item);
        selectedItemType = 'image';
        selectedImageId = item.id;
        selectedTextId = 0; selectedStrokeId = 0; selectedShapeId = 0;
        pushHistory();
        refreshImageLayerList();
        drawCanvas();
        // 添加图片后自动切换到指针工具，方便立即拖动
        activateTool('pointer');
    };
    img.onerror = function() { alert('图片加载失败：' + src); };
    img.src = src;
}
// 兼容附件管理器使用 window.xxx 调用
window.onAttachImageSelected = onAttachImageSelected;

function refreshImageLayerList() {
    var list = document.getElementById('imgLayerList');
    if (!list) return;
    list.innerHTML = '';
    if (!imageItems.length) {
        list.innerHTML = '<div style="color:#aaa;font-size:12px;text-align:center;padding:10px 0;">暂无图片图层</div>';
        return;
    }
    imageItems.forEach(function(img) {
        var div = document.createElement('div');
        div.className = 'pointer-item' + (img.id === selectedImageId && selectedItemType === 'image' ? ' selected' : '');
        div.innerHTML = '<span class="item-icon"><i class="fa fa-picture-o"></i></span>' +
            '<span class="item-text">' + escapeHtml('图片 #' + img.id) + '</span>' +
            '<button class="item-del" title="删除"><i class="fa fa-times"></i></button>';
        (function(item) {
            div.onclick = function() {
                selectedItemType = 'image'; selectedImageId = item.id;
                selectedTextId = 0; selectedStrokeId = 0; selectedShapeId = 0;
                refreshImageLayerList(); drawCanvas();
            };
            div.querySelector('.item-del').onclick = function(e) {
                e.stopPropagation();
                pushHistory();
                imageItems = imageItems.filter(function(x) { return x.id !== item.id; });
                if (selectedImageId === item.id) { selectedImageId = 0; selectedItemType = null; }
                refreshImageLayerList(); drawCanvas();
            };
        })(img);
        list.appendChild(div);
    });
}

function onPointerImageChange() {
    if (!selectedImageId) return;
    var img = imageItems.find(function(x) { return x.id === selectedImageId; });
    if (!img) return;
    var dw = displayW || 1;
    var dh = displayH || 1;
    var newW = parseInt(document.getElementById('ptrImgWidth').value, 10);
    var newH = parseInt(document.getElementById('ptrImgHeight').value, 10);
    if (newW > 0) img.w = newW / dw;
    if (newH > 0) img.h = newH / dh;
    drawCanvas();
}

// ==================== 图层排序 ====================
function moveItemInArray(arr, id, direction) {
    var idx = arr.findIndex(function(x) { return x.id === id; });
    if (idx === -1) return;
    if (direction === 'up' && idx > 0) {
        var tmp = arr[idx]; arr[idx] = arr[idx - 1]; arr[idx - 1] = tmp;
    } else if (direction === 'down' && idx < arr.length - 1) {
        var tmp2 = arr[idx]; arr[idx] = arr[idx + 1]; arr[idx + 1] = tmp2;
    } else if (direction === 'top') {
        var el = arr.splice(idx, 1)[0]; arr.push(el);
    } else if (direction === 'bottom') {
        var el2 = arr.splice(idx, 1)[0]; arr.unshift(el2);
    }
}

function getArrayByType(type) {
    if (type === 'text') return textItems;
    if (type === 'draw') return strokes;
    if (type === 'shape') return shapes;
    if (type === 'image') return imageItems;
    return null;
}

function movePointerItem(type, id, direction) {
    pushHistory();
    if (type === 'draw') {
        // 笔迹仅在笔迹层内排序（橡皮擦需离屏合成，无法跨类型）
        moveItemInArray(strokes, id, direction);
    } else {
        // 形状/图片/文本使用统一 zIndex 排序
        moveUnifiedLayer(type, id, direction);
    }
    refreshPointerList();
    drawCanvas();
}

function moveUnifiedLayer(type, id, direction) {
    var arr = getArrayByType(type);
    var item = arr ? arr.find(function(x) { return x.id === id; }) : null;
    if (!item) return;
    // 构建所有非笔迹图层的统一列表
    var layers = [];
    shapes.forEach(function(s) { layers.push(s); });
    imageItems.forEach(function(img) { layers.push(img); });
    textItems.forEach(function(t) { layers.push(t); });
    layers.sort(function(a, b) { return (a.zIndex || 0) - (b.zIndex || 0); });
    var idx = layers.indexOf(item);
    if (idx === -1) return;
    if (direction === 'top') {
        var maxZ = layers[layers.length - 1].zIndex || 0;
        item.zIndex = maxZ + 1;
    } else if (direction === 'bottom') {
        var minZ = layers[0].zIndex || 0;
        item.zIndex = minZ - 1;
    } else if (direction === 'up' && idx < layers.length - 1) {
        var above = layers[idx + 1];
        var tmpZ = item.zIndex; item.zIndex = above.zIndex; above.zIndex = tmpZ;
    } else if (direction === 'down' && idx > 0) {
        var below = layers[idx - 1];
        var tmpZ2 = item.zIndex; item.zIndex = below.zIndex; below.zIndex = tmpZ2;
    }
}

// 确认后隐藏右侧面板
function hidePanelAfterConfirm() {
    var panels = document.querySelectorAll('.tool-panel');
    panels.forEach(function(p) { p.classList.remove('active'); });
    var btns = document.querySelectorAll('.left-tool-btn');
    btns.forEach(function(b) { b.classList.remove('active'); });
    activeTool = '';
    cropActive = false;
}

// 自动确认上一个工具
function autoConfirmTool(tool) {
    switch (tool) {
        case 'crop': confirmCropTool(true); break;
        case 'filter': confirmFilterTool(true); break;
        case 'draw': confirmDrawTool(true); break;
        case 'eraser': confirmEraserTool(true); break;
        case 'mosaic': confirmMosaicTool(true); break;
        case 'text': confirmTextTool(true); break;
        case 'adjust': confirmAdjustTool(true); break;
        case 'shape': confirmShapeTool(true); break;
    }
}

function activateTool(toolName) {
    // 自动确认上一个工具的修改
    if (activeTool && activeTool !== toolName && toolDirty[activeTool]) {
        autoConfirmTool(activeTool);
    }

    activeTool = toolName;
    cropActive = (toolName === 'crop');

    // 更新左侧按钮
    var btns = document.querySelectorAll('.left-tool-btn');
    btns.forEach(function(b) {
        var id = b.id.replace('toolBtn', '').toLowerCase();
        b.classList.toggle('active', id === toolName);
    });

    // 显示对应面板
    var panels = document.querySelectorAll('.tool-panel');
    panels.forEach(function(p) { p.classList.remove('active'); });
    var panelId = 'toolPanel' + toolName.charAt(0).toUpperCase() + toolName.slice(1);
    var panel = document.getElementById(panelId);
    if (panel) panel.classList.add('active');

    // 指针工具刷新列表
    if (toolName === 'pointer') refreshPointerList();
    // 图片工具刷新列表
    if (toolName === 'image') refreshImageLayerList();
    // 非书写工具且非橡皮擦工具时隐藏画笔光标
    if (toolName !== 'draw' && toolName !== 'eraser') {
        var cursEl = document.getElementById('brushCursor');
        if (cursEl) cursEl.style.display = 'none';
    }
    // 马赛克工具隐藏画笔光标
    if (toolName === 'mosaic') {
        var cursElM = document.getElementById('brushCursor');
        if (cursElM) cursElM.style.display = 'none';
    }
    // 非马赛克工具时清除马赛克预览点
    if (toolName !== 'mosaic') {
        mosaicPreviewPt = null;
    }
    // 切换到橡皮擦时同步画笔类型
    if (toolName === 'eraser') {
        brushType = eraserShape;
    }
    // 画面调整工具同步滑块显示
    if (toolName === 'adjust') {
        onAdjustChange();
    }
    // 文本工具同步输入框
    if (toolName === 'text' && selectedTextId) populateTextInputsFromSelected();

    drawCanvas();
}

function getTransformedSize() {
    var w = originalImage.naturalWidth;
    var h = originalImage.naturalHeight;
    if (rotation === 90 || rotation === 270) return { w: h, h: w };
    return { w: w, h: h };
}

function getFilterCss(filterName) {
    switch (filterName) {
        case 'grayscale': return 'grayscale(1)';
        case 'invert': return 'invert(1)';
        case 'sepia': return 'sepia(1)';
        case 'vintage': return 'contrast(0.95) sepia(0.35) saturate(0.75)';
        case 'polaroid': return 'contrast(1.08) saturate(1.35) brightness(1.04)';
        case 'kodachrome': return 'contrast(1.15) saturate(1.6) hue-rotate(-8deg)';
        case 'technicolor': return 'contrast(1.2) saturate(1.8)';
        case 'brownie': return 'sepia(0.7) contrast(1.05) brightness(0.95)';
        case 'brightness': return 'brightness(1.18)';
        case 'gamma': return 'contrast(1.1) brightness(1.05)';
        case 'blur': return 'blur(2px)';
        default: return 'none';
    }
}

function getCombinedFilterCss(filters) {
    if (!filters || !filters.length) return 'none';
    var parts = [];
    filters.forEach(function(f) {
        var css = getFilterCss(f);
        if (css && css !== 'none') parts.push(css);
    });
    return parts.length ? parts.join(' ') : 'none';
}

function getPreviewFilterCss() {
    if (activeTool === 'filter' && selectedFilters.length > 0) {
        return getCombinedFilterCss(selectedFilters);
    }
    return 'none';
}

function drawStrokesToContext(ctx, width, height) {
    if (!strokes.length) return;

    // 用离屏 Canvas 支持橡皮擦 destination-out
    strokeOffCanvas.width = width;
    strokeOffCanvas.height = height;
    strokeOffCtx.clearRect(0, 0, width, height);

    strokes.forEach(function(stroke) {
        if (stroke.type === 'mosaic') {
            // 马赛克直接绘制 patch
            if (!stroke.patches) return;
            stroke.patches.forEach(function(p) {
                var src = p.canvas || null;
                if (!src && p.dataUrl) {
                    // 从历史快照恢复的 patch，懒加载 Image
                    if (!p._img) { p._img = new Image(); p._img.src = p.dataUrl; }
                    if (p._img.complete) src = p._img;
                }
                if (src) strokeOffCtx.drawImage(src, Math.round(p.nx * width), Math.round(p.ny * height), p.bw, p.bh);
            });
            return;
        }

        if (!stroke.points || stroke.points.length < 2) return;

        var isEraser = (stroke.type === 'eraser');
        strokeOffCtx.save();
        if (isEraser) {
            strokeOffCtx.globalCompositeOperation = 'destination-out';
            strokeOffCtx.strokeStyle = 'rgba(0,0,0,1)';
        } else {
            strokeOffCtx.globalCompositeOperation = 'source-over';
            strokeOffCtx.strokeStyle = stroke.color;
        }
        strokeOffCtx.lineWidth = stroke.size;
        if (stroke.type === 'square') {
            strokeOffCtx.lineJoin = 'miter';
            strokeOffCtx.lineCap = 'square';
        } else {
            strokeOffCtx.lineJoin = 'round';
            strokeOffCtx.lineCap = 'round';
        }
        strokeOffCtx.beginPath();
        strokeOffCtx.moveTo(stroke.points[0].x * width, stroke.points[0].y * height);
        for (var i = 1; i < stroke.points.length; i++) {
            strokeOffCtx.lineTo(stroke.points[i].x * width, stroke.points[i].y * height);
        }
        strokeOffCtx.stroke();
        strokeOffCtx.restore();
    });

    ctx.drawImage(strokeOffCanvas, 0, 0);

    // 指针模式下显示选中笔迹的边框
    if (activeTool === 'pointer' && selectedStrokeId) {
        var selStroke = strokes.find(function(s) { return s.id === selectedStrokeId; });
        if (selStroke && selStroke.points && selStroke.points.length) {
            var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            selStroke.points.forEach(function(pt) {
                var px = pt.x * width, py = pt.y * height;
                if (px < minX) minX = px; if (py < minY) minY = py;
                if (px > maxX) maxX = px; if (py > maxY) maxY = py;
            });
            ctx.save();
            ctx.strokeStyle = '#1c84c6';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 3]);
            ctx.strokeRect(minX - 5, minY - 5, maxX - minX + 10, maxY - minY + 10);
            ctx.setLineDash([]);
            ctx.restore();
        }
    }
}

function drawSingleTextItem(ctx, item, width, height, showSelection) {
    ctx.save();
    var fontStr = '';
    if (item.italic) fontStr += 'italic ';
    if (item.bold) fontStr += 'bold ';
    fontStr += item.size + 'px "' + item.font + '"';
    ctx.font = fontStr;
    ctx.textBaseline = 'top';

    var x = item.x * width;
    var y = item.y * height;
    var metrics = ctx.measureText(item.text);
    var boxW = Math.max(20, metrics.width);
    var boxH = item.size + 8;

    var rotate = item.rotate || 0;
    if (rotate) {
        ctx.translate(x + boxW / 2, y + boxH / 2);
        ctx.rotate(rotate * Math.PI / 180);
        ctx.translate(-(x + boxW / 2), -(y + boxH / 2));
    }

    var bgOpacity = (item.bgOpacity || 0) / 100;
    if (bgOpacity > 0) {
        ctx.fillStyle = hexToRgba(item.bgColor || '#ffffff', bgOpacity);
        ctx.fillRect(x - 3, y - 3, boxW + 6, boxH);
    }

    var sw = item.strokeWidth || 0;
    if (sw > 0) {
        ctx.strokeStyle = item.strokeColor || '#000000';
        ctx.lineWidth = sw;
        ctx.strokeText(item.text, x, y);
    }

    ctx.fillStyle = item.color;
    ctx.fillText(item.text, x, y);

    if (showSelection && (activeTool === 'text' || activeTool === 'pointer') && item.id === selectedTextId) {
        ctx.strokeStyle = '#1c84c6';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 3]);
        ctx.strokeRect(x - 3, y - 3, boxW + 6, boxH);
        ctx.setLineDash([]);
    }
    ctx.restore();
}

function drawTextItemsToContext(ctx, width, height, showSelection) {
    if (!textItems.length) return;
    textItems.forEach(function(item) {
        drawSingleTextItem(ctx, item, width, height, showSelection);
    });
}

function drawSingleImageItem(ctx, img, width, height, showSelection) {
    if (!img.el || !img.el.complete || img.el.naturalWidth === 0) return;
    var x = img.x * width;
    var y = img.y * height;
    var w = img.w * width;
    var h = img.h * height;
    ctx.save();
    ctx.drawImage(img.el, x, y, w, h);
    if (showSelection && selectedItemType === 'image' && img.id === selectedImageId) {
        ctx.strokeStyle = '#1c84c6';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([5, 3]);
        ctx.strokeRect(x, y, w, h);
        ctx.setLineDash([]);
        var hs = 8;
        ctx.fillStyle = '#fff';
        ctx.strokeStyle = '#1c84c6';
        ctx.lineWidth = 1.5;
        [[x, y], [x + w, y], [x, y + h], [x + w, y + h]].forEach(function(pt) {
            ctx.fillRect(pt[0] - hs / 2, pt[1] - hs / 2, hs, hs);
            ctx.strokeRect(pt[0] - hs / 2, pt[1] - hs / 2, hs, hs);
        });
    }
    ctx.restore();
}

function drawImageItemsToContext(ctx, width, height, showSelection) {
    if (!imageItems.length) return;
    imageItems.forEach(function(img) {
        drawSingleImageItem(ctx, img, width, height, showSelection);
    });
}

function hitTestImage(px, py, canvasW, canvasH) {
    for (var i = imageItems.length - 1; i >= 0; i--) {
        var img = imageItems[i];
        var x = img.x * canvasW;
        var y = img.y * canvasH;
        var w = img.w * canvasW;
        var h = img.h * canvasH;
        if (px >= x && px <= x + w && py >= y && py <= y + h) return img;
    }
    return null;
}

// 检测是否命中图片的角点把手（用于缩放）返回 corner: 'tl'|'tr'|'bl'|'br' 或 null
function hitTestImageCorner(px, py, canvasW, canvasH) {
    if (!selectedImageId || selectedItemType !== 'image') return null;
    var img = imageItems.find(function(x) { return x.id === selectedImageId; });
    if (!img) return null;
    var x = img.x * canvasW;
    var y = img.y * canvasH;
    var w = img.w * canvasW;
    var h = img.h * canvasH;
    var hs = 10;
    var corners = [
        { name: 'tl', cx: x,     cy: y     },
        { name: 'tr', cx: x + w, cy: y     },
        { name: 'bl', cx: x,     cy: y + h },
        { name: 'br', cx: x + w, cy: y + h }
    ];
    for (var i = 0; i < corners.length; i++) {
        var c = corners[i];
        if (Math.abs(px - c.cx) <= hs && Math.abs(py - c.cy) <= hs) return c.name;
    }
    return null;
}

// ==================== 统一图层绘制 ====================
// 将形状、图片、文本按 zIndex 统一排序绘制，支持跨类型图层排序
function drawUnifiedLayers(ctx, width, height, showSelection, opts) {
    opts = opts || {};
    var includeShapes = opts.includeShapes !== false;
    var includeText = opts.includeText !== false;
    var layers = [];
    if (includeShapes) {
        shapes.forEach(function(s, i) {
            if (s.zIndex == null) s.zIndex = 1000 + i;
            layers.push({ type: 'shape', item: s });
        });
    }
    imageItems.forEach(function(img, i) {
        if (img.zIndex == null) img.zIndex = 2000 + i;
        layers.push({ type: 'image', item: img });
    });
    if (includeText) {
        textItems.forEach(function(t, i) {
            if (t.zIndex == null) t.zIndex = 3000 + i;
            layers.push({ type: 'text', item: t });
        });
    }
    layers.sort(function(a, b) { return a.item.zIndex - b.item.zIndex; });
    layers.forEach(function(layer) {
        if (layer.type === 'shape') {
            var showShapeSel = showSelection && activeTool === 'pointer' && layer.item.id === selectedShapeId;
            drawSingleShape(ctx, layer.item, width, height, showShapeSel);
        } else if (layer.type === 'image') {
            drawSingleImageItem(ctx, layer.item, width, height, showSelection);
        } else if (layer.type === 'text') {
            drawSingleTextItem(ctx, layer.item, width, height, showSelection);
        }
    });
    // 绘制正在创建中的形状（尚未加入 shapes 数组）
    if (showSelection && includeShapes && currentShape) {
        drawSingleShape(ctx, currentShape, width, height, false);
    }
}

function drawCanvas() {
    var canvas = document.getElementById('mainCanvas');
    var ctx = canvas.getContext('2d');
    var size = getTransformedSize();
    displayW = size.w;
    displayH = size.h;

    var area = document.getElementById('canvasArea');
    var maxW = area.clientWidth - 160;
    var maxH = area.clientHeight - 80;
    var fitScale = Math.min(maxW / displayW, maxH / displayH, 1);
    var scale = fitScale * zoomLevel;

    var cw = Math.max(1, Math.round(displayW * scale));
    var ch = Math.max(1, Math.round(displayH * scale));
    canvas.width = cw;
    canvas.height = ch;

    ctx.save();
    ctx.clearRect(0, 0, cw, ch);
    ctx.translate(cw / 2, ch / 2);
    ctx.rotate(rotation * Math.PI / 180);
    ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);

    // 画面调整/滤镜预览 CSS filter
    var filterCss = 'none';
    if (activeTool === 'filter' && selectedFilters.length > 0) {
        filterCss = getCombinedFilterCss(selectedFilters);
    } else if (activeTool === 'adjust') {
        filterCss = getAdjustFilterCss();
    }
    ctx.filter = filterCss;

    var imgW, imgH;
    if (rotation === 90 || rotation === 270) {
        imgW = ch; imgH = cw;
    } else {
        imgW = cw; imgH = ch;
    }
    ctx.drawImage(originalImage, -imgW / 2, -imgH / 2, imgW, imgH);
    ctx.restore();

    // 笔迹始终在底层（包含橡皮擦/马赛克，需离屏合成）
    drawStrokesToContext(ctx, cw, ch);
    // 形状、图片、文本统一按 zIndex 排序绘制
    drawUnifiedLayers(ctx, cw, ch, true);

    // 马赛克工具拖动时显示画刷区域虚线框
    if (activeTool === 'mosaic' && mosaicPreviewPt) {
        var half = Math.round(mosaicBrushSize / 2);
        var px = Math.round(mosaicPreviewPt.nx * cw);
        var py = Math.round(mosaicPreviewPt.ny * ch);
        ctx.save();
        ctx.strokeStyle = 'rgba(255,255,255,0.9)';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 3]);
        ctx.strokeRect(px - half, py - half, half * 2, half * 2);
        ctx.setLineDash([]);
        ctx.restore();
    }

    document.getElementById('sizeText').textContent = displayW + ' px × ' + displayH + ' px';
    document.getElementById('dimWidth').value = Math.round((cropRect.w > 0 ? cropRect.w : 1) * displayW);
    document.getElementById('dimHeight').value = Math.round((cropRect.h > 0 ? cropRect.h : 1) * displayH);

    updateCropOverlay(cw, ch);
    refreshFilterUI();
}

function updateCropOverlay(cw, ch) {
    var overlay = document.getElementById('cropOverlay');
    var selection = document.getElementById('cropSelection');
    if (!cropActive) {
        overlay.classList.remove('active');
        return;
    }
    overlay.classList.add('active');

    var x = Math.round(cropRect.x * cw);
    var y = Math.round(cropRect.y * ch);
    var w = Math.round(cropRect.w * cw);
    var h = Math.round(cropRect.h * ch);
    selection.style.left = x + 'px';
    selection.style.top = y + 'px';
    selection.style.width = w + 'px';
    selection.style.height = h + 'px';
}

function resetCropRect() {
    cropRect = { x: 0, y: 0, w: 1, h: 1 };
}

function resetAll() {
