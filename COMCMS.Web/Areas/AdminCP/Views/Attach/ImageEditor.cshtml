function applyImageDataToOriginal(dataUrl, done) {
    var img = new Image();
    img.onload = function() {
        originalImage = img;
        if (done) done();
    };
    img.src = dataUrl;
}

function confirmCropTool(autoConfirm) {
    pushHistory();
    var outputW = Math.round(cropRect.w * displayW) || displayW;
    var outputH = Math.round(cropRect.h * displayH) || displayH;
    var data = generateFinalImage(outputW, outputH, { useCrop: true, includeDraw: false, includeText: false });

    // 裁剪时重新映射笔迹和文本坐标
    if (cropRect.x !== 0 || cropRect.y !== 0 || cropRect.w !== 1 || cropRect.h !== 1) {
        remapLayersForCrop(cropRect);
    }

    applyImageDataToOriginal(data, function() {
        rotation = 0;
        flipH = false;
        flipV = false;
        zoomLevel = 1;
        aspectRatio = 0;
        resetCropRect();
        clearToolDirty('crop');
        if (!autoConfirm) hidePanelAfterConfirm();
        updateZoomText();
        drawCanvas();
    });
}

// 裁剪确认时重新映射笔迹和文本坐标
function remapLayersForCrop(rect) {
    strokes.forEach(function(stroke) {
        if (!stroke.points) return;
        stroke.points = stroke.points.map(function(pt) {
            return {
                x: (pt.x - rect.x) / rect.w,
                y: (pt.y - rect.y) / rect.h
            };
        });
        // mosaic patches 坐标重映射
        if (stroke.type === 'mosaic' && stroke.patches) {
            stroke.patches = stroke.patches.map(function(p) {
                return Object.assign({}, p, {
                    nx: (p.nx - rect.x) / rect.w,
                    ny: (p.ny - rect.y) / rect.h
                });
            });
        }
    });
    textItems.forEach(function(item) {
        item.x = (item.x - rect.x) / rect.w;
        item.y = (item.y - rect.y) / rect.h;
    });
    shapes.forEach(function(shape) {
        shape.x1 = (shape.x1 - rect.x) / rect.w;
        shape.y1 = (shape.y1 - rect.y) / rect.h;
        shape.x2 = (shape.x2 - rect.x) / rect.w;
        shape.y2 = (shape.y2 - rect.y) / rect.h;
    });
    imageItems.forEach(function(img) {
        img.x = (img.x - rect.x) / rect.w;
        img.y = (img.y - rect.y) / rect.h;
        img.w = img.w / rect.w;
        img.h = img.h / rect.h;
    });
}

function confirmFilterTool(autoConfirm) {
    if (!selectedFilters.length) {
        clearToolDirty('filter');
        if (!autoConfirm) hidePanelAfterConfirm();
        return;
    }
    pushHistory();
    var data = generateFinalImage(displayW, displayH, { useCrop: false, includeDraw: false, includeText: false, filters: selectedFilters });
    applyImageDataToOriginal(data, function() {
        selectedFilters = [];
        clearToolDirty('filter');
        if (!autoConfirm) hidePanelAfterConfirm();
        drawCanvas();
    });
}

